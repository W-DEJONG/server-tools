#!/bin/bash
set -eo pipefail

usage="Usage: server-tool update-php [-y]"
if [ $# -ne 0 ]; then
  echo "$usage"
  exit 1
fi

installed_php_versions() {
  local dir version
  if [ ! -d /etc/php ]; then
    return 0
  fi

  for dir in /etc/php/*; do
    [ -d "$dir" ] || continue
    version="$(basename "$dir")"
    [[ "$version" =~ ^[0-9]+\.[0-9]+$ ]] || continue
    if command -v "php${version}" >/dev/null 2>&1; then
      printf '%s\n' "$version"
    fi
  done
}

mapfile -t versions < <(installed_php_versions | sort -V)
if [ ${#versions[@]} -eq 0 ]; then
  echo "Error: no PHP versions are installed."
  echo "Run: server-tool install php"
  exit 1
fi

version_list="$(printf '%s, ' "${versions[@]}")"
version_list="${version_list%, }"

confirm_or_exit "This will upgrade PHP ${version_list} to the latest patch and restart PHP-FPM. Continue? (y/n): "

ensure_sury_php_repo

packages=()
for version in "${versions[@]}"; do
  while IFS=$'\t' read -r status pkg; do
    [ "$status" = "install ok installed" ] || continue
    case "$pkg" in
      "php${version}" | "php${version}-"*)
        packages+=("$pkg")
        ;;
    esac
  done < <(dpkg-query -W -f='${Status}\t${Package}\n' "php${version}*" 2>/dev/null || true)
done

if [ ${#packages[@]} -eq 0 ]; then
  echo "Error: no installed PHP packages were found."
  exit 1
fi

echo "Upgrading PHP ${version_list} to the latest patch..."
apt-get install --only-upgrade -y "${packages[@]}"

for version in "${versions[@]}"; do
  if php_fpm_is_installed "$version"; then
    "php-fpm${version}" -tt
  fi
done

for version in "${versions[@]}"; do
  if php_fpm_is_installed "$version"; then
    systemctl try-restart "php${version}-fpm"
  fi
done

echo
echo "PHP updated to the latest patch:"
for version in "${versions[@]}"; do
  printf '  %s: %s\n' "$version" "$("php${version}" -r 'echo PHP_VERSION;')"
done
