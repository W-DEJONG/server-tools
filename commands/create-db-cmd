#!/bin/bash
set -eo pipefail

if [ $# -lt 1 ]; then
    echo "Usage: server-tool create-db <db_name> [-y]"
    exit 1
fi

db_name=$1

echo "Database: $db_name"
echo "User: $db_name"
confirm_or_exit "This will create a PostgreSQL database and user '$db_name'. Do you want to proceed? (y/n): "

create_postgres_database "$db_name"

if [ "${CREATED_DB_IS_NEW:-0}" -ne 1 ]; then
  exit 0
fi

echo
echo "PostgreSQL database is ready."
echo "  Database: $db_name"
echo "  User:     $db_name"
echo "  Password: $CREATED_DB_PASSWORD"
echo "  Host:     localhost"
echo
echo "Connect: psql -h localhost -U $db_name -d $db_name"
echo "Store this password now; it is not saved by server-tool."
