#!/bin/bash
set -eo pipefail

usage="Usage: server-tool dump-db <username> <application> [<target-folder>] [-y]"
if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "$usage"
  exit 1
fi

username="$1"
app_name="$2"
target_folder="${3:-$PWD}"

require_application "$username" "$app_name"
load_app_db_env "$APP_ROOT/.env.db"

if [ ! -d "$target_folder" ]; then
  echo "Error: target folder does not exist: $target_folder"
  exit 1
fi

target_folder="$(readlink -f "$target_folder")"
stamp="$(date +%Y%m%d-%H%M%S)"
if [ "$DB_CONNECTION" = "mysql" ]; then
  require_mysql_client mysqldump
  dump_file="$target_folder/${app_name}-${stamp}.sql.gz"
else
  require_postgres_client pg_dump
  dump_file="$target_folder/${app_name}-${stamp}.dump"
fi

echo "Username: $username"
echo "Application: $app_name"
echo "Database: $DB_DATABASE"
echo "Type: $DB_CONNECTION"
echo "Output: $dump_file"
confirm_or_exit "This will dump the database of $username/$app_name. Do you want to proceed? (y/n): "

if [ "$DB_CONNECTION" = "mysql" ]; then
  MYSQL_PWD="$DB_PASSWORD" "$(mysql_dump_bin)" \
    --host="$DB_HOST" \
    --port="$DB_PORT" \
    --user="$DB_USERNAME" \
    --single-transaction \
    --routines \
    --triggers \
    "$DB_DATABASE" | gzip -c > "$dump_file"
else
  PGPASSWORD="$DB_PASSWORD" pg_dump \
    --host="$DB_HOST" \
    --port="$DB_PORT" \
    --username="$DB_USERNAME" \
    --dbname="$DB_DATABASE" \
    --clean \
    --no-acl \
    --format=custom \
    --no-owner \
    --file="$dump_file"
fi

chmod 640 "$dump_file"

echo
echo "Database dump written to $dump_file"
