#!/bin/bash
set -eo pipefail

if [ $# -ne 0 ]; then
    echo "Usage: server-tool list-apps"
    exit 1
fi

if [ ! -d /home ]; then
    exit 0
fi

apps=()

for user_home in /home/*; do
    [ -d "$user_home" ] || continue
    username="$(basename "$user_home")"

    case "$username" in
        ""|*/*|root|admin|www-data|nginx|nobody|daemon)
            continue
            ;;
    esac

    for app_dir in "$user_home"/*; do
        [ -d "$app_dir" ] || continue
        app_name="$(basename "$app_dir")"

        case "$app_name" in
            ""|*/*|.|..|.ssh)
                continue
                ;;
        esac

        if [ -f "${app_dir}/nginx/${app_name}.conf" ]; then
            apps+=("${username} ${app_name}")
        fi
    done
done

if [ ${#apps[@]} -eq 0 ]; then
    exit 0
fi

printf '%s\n' "${apps[@]}" | sort
