#!/bin/bash
set -eo pipefail

usage="Usage: server-tool backup-app <username> <application> [--enable|--disable] [-y]"
enable_backup=0
disable_backup=0
positionals=()

while [ $# -gt 0 ]; do
  case "$1" in
    --enable)
      enable_backup=1
      shift
      ;;
    --disable)
      disable_backup=1
      shift
      ;;
    *)
      positionals+=("$1")
      shift
      ;;
  esac
done

if [ ${#positionals[@]} -ne 2 ]; then
  echo "$usage"
  exit 1
fi

if [ "$enable_backup" -eq 1 ] && [ "$disable_backup" -eq 1 ]; then
  echo "Error: --enable and --disable cannot be used together."
  echo "$usage"
  exit 1
fi

username="${positionals[0]}"
app_name="${positionals[1]}"
require_application "$username" "$app_name"
cron_file="$(app_backup_cron_file "$username" "$app_name")"
legacy_cron_file="/etc/cron.d/server-tool-backup-${username}-${app_name}"

remove_legacy_backup_cron_file() {
  if [ "$legacy_cron_file" != "$cron_file" ] && [ -f "$legacy_cron_file" ]; then
    rm -f "$legacy_cron_file"
  fi
}

if [ "$enable_backup" -eq 1 ]; then
  echo "Username: $username"
  echo "Application: $app_name"
  echo "Cron file: $cron_file"
  confirm_or_exit "This will enable a daily backup cron for $username/$app_name. Do you want to proceed? (y/n): "

  ensure_cron
  server_tool_bin="$(command -v server-tool || true)"
  if [ -z "$server_tool_bin" ]; then
    server_tool_bin="$SERVER_TOOL_ROOT/server-tool"
  fi

  cat > "$cron_file" <<EOF
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

0 3 * * * root $server_tool_bin backup-app $username $app_name -y
EOF
  chmod 644 "$cron_file"
  remove_legacy_backup_cron_file

  echo
  echo "Daily backup cron enabled for $username/$app_name."
  echo "  Schedule: 03:00"
  echo "  File:     $cron_file"
  exit 0
fi

if [ "$disable_backup" -eq 1 ]; then
  echo "Username: $username"
  echo "Application: $app_name"
  echo "Cron file: $cron_file"
  confirm_or_exit "This will disable the daily backup cron for $username/$app_name. Do you want to proceed? (y/n): "

  removed=0
  if [ -f "$cron_file" ]; then
    rm -f "$cron_file"
    removed=1
  fi
  if [ "$legacy_cron_file" != "$cron_file" ] && [ -f "$legacy_cron_file" ]; then
    rm -f "$legacy_cron_file"
    removed=1
  fi

  if [ "$removed" -eq 1 ]; then
    echo
    echo "Daily backup cron disabled for $username/$app_name."
  else
    echo
    echo "No backup cron is installed for $username/$app_name."
  fi
  exit 0
fi

load_backup_config
require_aws_cli

if ! command -v zip >/dev/null 2>&1; then
  echo "Error: zip is not installed. Run: server-tool init-server"
  exit 1
fi

weekday="$(LC_ALL=C date +%A | tr '[:upper:]' '[:lower:]')"
s3_uri="s3://${S3_BUCKET}/${SERVER_NAME}/${username}/${app_name}/${weekday}.zip"

echo "Username: $username"
echo "Application: $app_name"
echo "Server: $SERVER_NAME"
echo "S3 bucket: $S3_BUCKET"
if [ -n "${S3_REGION:-}" ]; then
  echo "S3 region: $S3_REGION"
fi
echo "Destination: $s3_uri"
if [ -f "$APP_ROOT/.env.db" ]; then
  echo "Database: yes"
else
  echo "Database: no (.env.db missing; files only)"
fi
confirm_or_exit "This will backup $username/$app_name and upload it to S3. Do you want to proceed? (y/n): "

workdir=""
cleanup_backup_workdir() {
  if [ -n "$workdir" ] && [ -d "$workdir" ]; then
    rm -rf "$workdir"
  fi
}
trap cleanup_backup_workdir EXIT

workdir="$(large_temp_dir)" || exit
chmod 700 "$workdir"
echo "Work directory: $workdir"
zip_file="$workdir/${app_name}-${weekday}.zip"

if [ -f "$APP_ROOT/.env.db" ]; then
  mkdir -p "$workdir/db"
  "$SERVER_TOOL_ROOT/server-tool" dump-db -y "$username" "$app_name" "$workdir/db"
else
  echo "Warning: database credentials file not found: $APP_ROOT/.env.db"
  echo "Continuing with a files-only backup."
fi

zip_excludes=(
  -x "log/*"
  -x "log/"
  -x "releases/*"
  -x "releases/"
  -x "node_modules/*"
  -x "node_modules/"
  -x "*/node_modules/*"
  -x "*/node_modules/"
  -x ".git/*"
  -x ".git/"
  -x "*/.git/*"
  -x "*/.git/"
  -x ".env"
  -x "*/.env"
  -x ".env.db"
  -x "*/.env.db"
  -x "nginx/certs/*"
  -x "nginx/certs/"
  -x "*/nginx/certs/*"
  -x "*/nginx/certs/"
  -x "nginx/ssl/*"
  -x "nginx/ssl/"
  -x "*/nginx/ssl/*"
  -x "*/nginx/ssl/"
  -x "storage/framework/*"
  -x "storage/framework/"
  -x "*/storage/framework/*"
  -x "*/storage/framework/"
  -x "storage/logs/*"
  -x "storage/logs/"
  -x "*/storage/logs/*"
  -x "*/storage/logs/"
  -x "/storage/app/private/livewire-tmp/*"
  -x "/storage/app/private/livewire-tmp/"
  -x "*/storage/app/private/livewire-tmp/*"
  -x "*/storage/app/private/livewire-tmp/"
)
backup_current_rel=""
backup_skip_install=0
if [ -L "$APP_ROOT/current" ]; then
  current_target="$(readlink "$APP_ROOT/current")"
  current_target="${current_target%/}"
  current_phys="$(readlink -f "$APP_ROOT/current" 2>/dev/null || true)"
  case "$current_phys" in
    "$APP_ROOT"/*) backup_current_rel="${current_phys#"$APP_ROOT"/}" ;;
  esac
  case "$current_target" in
    install|./install)
      backup_skip_install=1
      zip_excludes+=(-x "install/*" -x "install/")
      ;;
  esac
fi

# A symlink whose target is already inside the application would be stored
# twice, because zip follows links. current itself stays followed so the
# active release is archived as current/. Other internal links are stored
# as links, relative to that archive path rather than releases/<id>/.
backup_symlink_is_skipped() {
  local rel="$1"
  case "$rel" in
    current|log|log/*|releases|releases/*)
      return 0
      ;;
    .env|*/.env|.env.db|*/.env.db)
      return 0
      ;;
    node_modules|node_modules/*|*/node_modules|*/node_modules/*)
      return 0
      ;;
    .git|.git/*|*/.git|*/.git/*)
      return 0
      ;;
    nginx/certs|nginx/certs/*|*/nginx/certs|*/nginx/certs/*)
      return 0
      ;;
    nginx/ssl|nginx/ssl/*|*/nginx/ssl|*/nginx/ssl/*)
      return 0
      ;;
    storage/framework|storage/framework/*|*/storage/framework|*/storage/framework/*)
      return 0
      ;;
    storage/logs|storage/logs/*|*/storage/logs|*/storage/logs/*)
      return 0
      ;;
    storage/app/private/livewire-tmp|storage/app/private/livewire-tmp/*|*/storage/app/private/livewire-tmp|*/storage/app/private/livewire-tmp/*)
      return 0
      ;;
  esac
  if [ "$backup_skip_install" -eq 1 ]; then
    case "$rel" in
      install|install/*) return 0 ;;
    esac
  fi
  return 1
}

backup_list_symlinks() {
  find "$APP_ROOT" \
    \( -path "$APP_ROOT/log" -o -path "$APP_ROOT/releases" -o -name node_modules -o -name .git \
       -o -path "$APP_ROOT/nginx/certs" -o -path "$APP_ROOT/nginx/ssl" \
       -o -path '*/storage/framework' -o -path '*/storage/logs' \
       -o -path '*/storage/app/private/livewire-tmp' \) -prune \
    -o -type l -print
  if [ -e "$APP_ROOT/current" ]; then
    find -H "$APP_ROOT/current" \
      \( -name node_modules -o -name .git \
         -o -path '*/nginx/certs' -o -path '*/nginx/ssl' \
         -o -path '*/storage/framework' -o -path '*/storage/logs' \
         -o -path '*/storage/app/private/livewire-tmp' \) -prune \
      -o -type l -print
  fi
}

backup_archive_target() {
  local target_rel="$1"
  if [ -n "$backup_current_rel" ] && [ "$backup_current_rel" != "current" ]; then
    case "$target_rel" in
      "$backup_current_rel"|"$backup_current_rel"/*)
        target_rel="current${target_rel#"$backup_current_rel"}"
        ;;
    esac
  fi
  printf '%s\n' "$target_rel"
}

backup_relative_link() {
  local from="$1"
  local to="$2"
  local prefix rel="" rest

  [ "$from" = "." ] && from=""
  while [ -n "$from" ] && [ -n "$to" ]; do
    prefix="${from%%/*}"
    if [ "$prefix" != "${to%%/*}" ]; then
      break
    fi
    if [ "$from" = "$prefix" ]; then
      from=""
    else
      from="${from#*/}"
    fi
    if [ "$to" = "$prefix" ]; then
      to=""
    else
      to="${to#*/}"
    fi
  done

  rest="$from"
  while [ -n "$rest" ]; do
    rel="${rel}../"
    if [ "$rest" = "${rest%%/*}" ]; then
      rest=""
    else
      rest="${rest#*/}"
    fi
  done

  if [ -z "$to" ]; then
    rel="${rel%/}"
    [ -n "$rel" ] || rel="."
    printf '%s\n' "$rel"
    return
  fi
  printf '%s%s\n' "$rel" "$to"
}

backup_collect_internal_symlinks() {
  local path rel target seen duplicate
  backup_internal_symlinks=()

  while IFS= read -r path; do
    [ -n "$path" ] || continue
    rel="${path#"$APP_ROOT"/}"
    if [ "$rel" = "$path" ] || backup_symlink_is_skipped "$rel"; then
      continue
    fi
    if [ ! -L "$path" ]; then
      continue
    fi
    target="$(readlink -f "$path" 2>/dev/null || true)"
    case "$target" in
      "$APP_ROOT"|"$APP_ROOT"/*) ;;
      *) continue ;;
    esac

    duplicate=0
    if [ "${#backup_internal_symlinks[@]}" -gt 0 ]; then
      for seen in "${backup_internal_symlinks[@]}"; do
        if [ "$seen" = "$rel" ]; then
          duplicate=1
          break
        fi
      done
    fi
    if [ "$duplicate" -eq 1 ]; then
      continue
    fi

    backup_internal_symlinks+=("$rel")
    zip_excludes+=(-x "$rel" -x "$rel/*")
  done < <(backup_list_symlinks)
}

backup_store_internal_symlinks() {
  local rel target target_rel archive_target from_dir relative link_root

  if [ "${#backup_internal_symlinks[@]}" -eq 0 ]; then
    return 0
  fi

  link_root="$workdir/symlinks"
  rm -rf "$link_root"
  for rel in "${backup_internal_symlinks[@]}"; do
    target="$(readlink -f "$APP_ROOT/$rel")"
    if [ "$target" = "$APP_ROOT" ]; then
      target_rel="."
    else
      target_rel="${target#"$APP_ROOT"/}"
    fi
    archive_target="$(backup_archive_target "$target_rel")"
    from_dir="$(dirname "$rel")"
    relative="$(backup_relative_link "$from_dir" "$archive_target")"
    mkdir -p "$link_root/$(dirname "$rel")"
    ln -s "$relative" "$link_root/$rel"
  done

  (
    cd "$link_root"
    zip -y "$zip_file" "${backup_internal_symlinks[@]}"
  )
}

backup_collect_internal_symlinks

echo "Creating archive..."
(
  cd "$APP_ROOT"
  zip -r "$zip_file" . "${zip_excludes[@]}"
)

if [ -d "$workdir/db" ]; then
  (cd "$workdir" && zip -r "$zip_file" db)
fi

backup_store_internal_symlinks

echo "Uploading archive to $s3_uri"
aws_s3_upload "$zip_file" "$s3_uri"

echo
echo "Backup uploaded to $s3_uri"
