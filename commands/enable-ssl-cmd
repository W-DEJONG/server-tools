#!/bin/bash
set -eo pipefail

self_signed=0
renew=0
domain=""
email=""
positionals=()
usage="Usage: server-tool enable-ssl <username> <application> [-d <domain>] [-e <email>] [--self-signed] [--renew] [-y]"
while [ $# -gt 0 ]; do
  case "$1" in
    -d|--domain)
      if [ -z "${2:-}" ]; then
        echo "Error: -d requires a domain"
        echo "$usage"
        exit 1
      fi
      domain="$2"
      shift 2
      ;;
    -e|--email)
      if [ -z "${2:-}" ]; then
        echo "Error: -e requires an email address"
        echo "$usage"
        exit 1
      fi
      email="$2"
      shift 2
      ;;
    --self-signed)
      self_signed=1
      shift
      ;;
    --renew)
      renew=1
      shift
      ;;
    *)
      positionals+=("$1")
      shift
      ;;
  esac
done

if [ ${#positionals[@]} -ne 2 ]; then
  echo "$usage"
  exit 1
fi

username="${positionals[0]}"
app_name="${positionals[1]}"
require_application "$username" "$app_name"

php_version="$(app_php_version_from_nginx "$APP_NGINX_CONF")"
if [ -z "$php_version" ]; then
  echo "Error: could not determine PHP version from $APP_NGINX_CONF"
  exit 1
fi

if [ -z "$domain" ]; then
  domain="$(app_server_name_from_nginx "$APP_NGINX_CONF")"
fi
if [ -z "$domain" ]; then
  domain="$app_name"
fi

if ! [[ "$domain" =~ ^[A-Za-z0-9._-]+$ ]]; then
  echo "Error: invalid domain '$domain'"
  exit 1
fi

if [ "$renew" -eq 1 ] && [ "$self_signed" -eq 0 ] && [ ! -d "/etc/letsencrypt/live/${domain}" ]; then
  self_signed=1
fi

echo "Username: $username"
echo "Application: $app_name"
echo "Domain: $domain"
if [ "$self_signed" -eq 1 ]; then
  echo "Certificate: self-signed"
elif [ -n "$email" ]; then
  echo "Certificate: Let's Encrypt ($email)"
else
  echo "Certificate: Let's Encrypt"
fi

if [ "$renew" -eq 1 ]; then
  confirm_or_exit "This will renew the HTTPS certificate for $app_name. Do you want to proceed? (y/n): "
else
  confirm_or_exit "This will enable HTTPS for $app_name. Do you want to proceed? (y/n): "
fi

ssl_dir="$APP_ROOT/nginx/ssl"
ssl_cert="$ssl_dir/${domain}.pem"
ssl_key="$ssl_dir/${domain}.key"
mkdir -p "$ssl_dir"

create_self_signed_cert() {
  echo "Creating self-signed certificate..."
  openssl req -x509 -nodes -days $((365 * 15)) -newkey rsa:2048 \
    -keyout "$ssl_key" \
    -out "$ssl_cert" \
    -subj "/CN=${domain}"
}

request_letsencrypt_cert() {
  local force_renewal="$1"
  if ! command -v certbot >/dev/null 2>&1; then
    echo "Error: certbot is not installed. Run: server-tool install nginx"
    exit 1
  fi

  local certbot_args=(certonly --webroot -w "$APP_ROOT/current/public" -d "$domain" --non-interactive --agree-tos)
  if [ -n "$email" ]; then
    certbot_args+=(--email "$email")
  else
    certbot_args+=(--register-unsafely-without-email)
  fi
  if [ "$force_renewal" -eq 1 ]; then
    certbot_args+=(--force-renewal)
  fi

  echo "Requesting Let's Encrypt certificate..."
  certbot "${certbot_args[@]}"
  cp "/etc/letsencrypt/live/${domain}/fullchain.pem" "$ssl_cert"
  cp "/etc/letsencrypt/live/${domain}/privkey.pem" "$ssl_key"

  local hook_dir="/etc/letsencrypt/renewal-hooks/deploy"
  mkdir -p "$hook_dir"
  cat > "${hook_dir}/${username}_${app_name}.sh" <<EOF
#!/bin/bash
cp "/etc/letsencrypt/live/${domain}/fullchain.pem" "$ssl_cert"
cp "/etc/letsencrypt/live/${domain}/privkey.pem" "$ssl_key"
nginx -s reload
EOF
  chmod 750 "${hook_dir}/${username}_${app_name}.sh"
}

apply_cert_permissions() {
  chmod 640 "$ssl_cert" "$ssl_key"
  chown "$username:$username" "$ssl_dir" "$ssl_cert" "$ssl_key"
}

if [ "$renew" -eq 1 ]; then
  if ! grep -q 'listen 443' "$APP_NGINX_CONF"; then
    echo "Error: SSL is not enabled for $app_name. Run enable-ssl without --renew first."
    exit 1
  fi

  if [ "$self_signed" -eq 1 ]; then
    create_self_signed_cert
  else
    request_letsencrypt_cert 1
  fi
  apply_cert_permissions
  reload_nginx

  echo
  echo "HTTPS certificate renewed."
  echo "  Domain: $domain"
  echo "  Cert:   $ssl_cert"
  echo "  Key:    $ssl_key"
  exit 0
fi

if grep -q 'listen 443' "$APP_NGINX_CONF"; then
  echo "SSL is already enabled in $APP_NGINX_CONF, leaving the nginx config unchanged."
else
  if [ ! -f "$ssl_cert" ] || [ ! -f "$ssl_key" ]; then
    if [ "$self_signed" -eq 1 ]; then
      create_self_signed_cert
    else
      request_letsencrypt_cert 0
    fi
  else
    echo "Using existing certificate files in $ssl_dir"
  fi

  apply_cert_permissions

  render_nginx_app_conf \
    "$SERVER_TOOL_ROOT/templates/nginx-laravel-ssl.conf" \
    "$APP_NGINX_CONF" \
    "$username" \
    "$app_name" \
    "$APP_ROOT" \
    "$php_version" \
    "$domain" \
    "$ssl_cert" \
    "$ssl_key"
  chown "$username:$username" "$APP_NGINX_CONF"
fi

reload_nginx

echo
echo "HTTPS is ready."
echo "  Domain: $domain"
echo "  Cert:   $ssl_cert"
echo "  Key:    $ssl_key"
