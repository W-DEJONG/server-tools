#!/bin/bash
set -eo pipefail

self_signed=0
renew=0
domain=""
email=""
positionals=()
usage="Usage: server-tool enable-ssl <username> <application> [-d <domain>] [-e <email>] [--self-signed] [--renew] [-y]"
while [ $# -gt 0 ]; do
  case "$1" in
    -d|--domain)
      if [ -z "${2:-}" ]; then
        echo "Error: -d requires a domain"
        echo "$usage"
        exit 1
      fi
      domain="$2"
      shift 2
      ;;
    -e|--email)
      if [ -z "${2:-}" ]; then
        echo "Error: -e requires an email address"
        echo "$usage"
        exit 1
      fi
      email="$2"
      shift 2
      ;;
    --self-signed)
      self_signed=1
      shift
      ;;
    --renew)
      renew=1
      shift
      ;;
    *)
      positionals+=("$1")
      shift
      ;;
  esac
done

if [ ${#positionals[@]} -ne 2 ]; then
  echo "$usage"
  exit 1
fi

username="${positionals[0]}"
app_name="${positionals[1]}"
require_application "$username" "$app_name"

php_version="$(app_php_version_from_nginx "$APP_NGINX_CONF")"
if [ -z "$php_version" ]; then
  echo "Error: could not determine PHP version from $APP_NGINX_CONF"
  exit 1
fi

if [ -z "$domain" ]; then
  domain="$(app_server_name_from_nginx "$APP_NGINX_CONF")"
fi
if [ -z "$domain" ]; then
  domain="$app_name"
fi

require_valid_domain "$domain"

existing_names="$(app_server_names_from_nginx "$APP_NGINX_CONF")"
server_names="$(append_unique_name "$existing_names" "$domain")"

already_ssl=0
if grep -q 'listen 443' "$APP_NGINX_CONF"; then
  already_ssl=1
fi

has_letsencrypt=0
if [ "$already_ssl" -eq 1 ] && app_letsencrypt_lineage "$APP_NGINX_CONF" >/dev/null; then
  has_letsencrypt=1
fi

echo "Username: $username"
echo "Application: $app_name"
echo "Domain: $domain"
echo "Server names: $server_names"
if [ "$self_signed" -eq 1 ]; then
  echo "Certificate: self-signed"
elif [ -n "$email" ]; then
  echo "Certificate: Let's Encrypt ($email)"
else
  echo "Certificate: Let's Encrypt"
fi

if [ "$self_signed" -eq 0 ] && [ "$already_ssl" -eq 1 ] && [ "$has_letsencrypt" -eq 0 ]; then
  confirm_or_exit "This will replace the self-signed certificate for $app_name with Let's Encrypt. Do you want to proceed? (y/n): "
elif [ "$renew" -eq 1 ]; then
  confirm_or_exit "This will renew the HTTPS certificate for $app_name. Do you want to proceed? (y/n): "
else
  confirm_or_exit "This will enable HTTPS for $app_name. Do you want to proceed? (y/n): "
fi

ssl_dir="$APP_ROOT/nginx/ssl"
ssl_cert="$ssl_dir/${domain}.pem"
ssl_key="$ssl_dir/${domain}.key"
mkdir -p "$ssl_dir"

create_self_signed_cert() {
  echo "Creating self-signed certificate..."
  openssl req -x509 -nodes -days $((365 * 15)) -newkey rsa:2048 \
    -keyout "$ssl_key" \
    -out "$ssl_cert" \
    -subj "/CN=${domain}"
}

request_letsencrypt_cert() {
  local force_renewal="$1"
  local mode="issue"
  if [ "$force_renewal" -eq 1 ]; then
    mode="replace"
  fi
  local names="$server_names"
  if [ -z "$names" ]; then
    names="$domain"
  fi
  # shellcheck disable=SC2086
  request_letsencrypt_names "$domain" "$APP_ROOT/current/public" "$mode" "$email" $names
  copy_letsencrypt_to_app "$domain" "$ssl_cert" "$ssl_key"
  write_letsencrypt_deploy_hook "$username" "$app_name" "$domain" "$ssl_cert" "$ssl_key"
  ensure_certbot_autorenew
}

apply_cert_permissions() {
  chmod 640 "$ssl_cert" "$ssl_key"
  chown "$username:$username" "$ssl_dir" "$ssl_cert" "$ssl_key"
}

use_nginx_cert_paths() {
  local configured_cert configured_key
  configured_cert="$(app_ssl_cert_from_nginx "$APP_NGINX_CONF")"
  configured_key="$(app_ssl_key_from_nginx "$APP_NGINX_CONF")"
  case "$configured_cert" in
    "$APP_ROOT/nginx/ssl/"*) ;;
    *) return 0 ;;
  esac
  case "$configured_key" in
    "$APP_ROOT/nginx/ssl/"*) ;;
    *) return 0 ;;
  esac
  ssl_cert="$configured_cert"
  ssl_key="$configured_key"
  ssl_dir="$(dirname "$configured_cert")"
  mkdir -p "$ssl_dir"
}

issue_letsencrypt() {
  if [ -d "/etc/letsencrypt/live/${domain}" ]; then
    request_letsencrypt_cert 1
  else
    request_letsencrypt_cert 0
  fi
}

sync_server_names() {
  local current_names
  current_names="$(app_server_names_from_nginx "$APP_NGINX_CONF")"
  if [ "$current_names" != "$server_names" ]; then
    set_nginx_server_names "$APP_NGINX_CONF" "$server_names"
    chown "$username:$username" "$APP_NGINX_CONF"
  fi
}

if [ "$renew" -eq 1 ]; then
  if [ "$already_ssl" -eq 0 ]; then
    echo "Error: SSL is not enabled for $app_name. Run enable-ssl without --renew first."
    exit 1
  fi

  use_nginx_cert_paths
  if [ "$self_signed" -eq 1 ]; then
    create_self_signed_cert
  else
    issue_letsencrypt
  fi
  apply_cert_permissions
  sync_server_names
  reload_nginx

  sync_app_monitoring "$username" "$app_name"

  echo
  if [ "$self_signed" -eq 0 ] && [ "$has_letsencrypt" -eq 0 ]; then
    echo "Replaced the self-signed certificate with Let's Encrypt."
  else
    echo "HTTPS certificate renewed."
  fi
  echo "  Domain: $domain"
  echo "  Cert:   $ssl_cert"
  echo "  Key:    $ssl_key"
  exit 0
fi

if [ "$already_ssl" -eq 1 ]; then
  if [ "$self_signed" -eq 1 ] || [ "$has_letsencrypt" -eq 1 ]; then
    use_nginx_cert_paths
    echo "SSL is already enabled in $APP_NGINX_CONF, leaving the nginx config unchanged."
    reload_nginx
    sync_app_monitoring "$username" "$app_name"
    echo
    echo "HTTPS is already enabled."
    echo "  Domain: $domain"
    echo "  Cert:   $ssl_cert"
    echo "  Key:    $ssl_key"
    exit 0
  fi

  use_nginx_cert_paths
  echo "Replacing the self-signed certificate with Let's Encrypt..."
  issue_letsencrypt
  apply_cert_permissions
  sync_server_names
  replaced_self_signed=1
else
  if [ "$self_signed" -eq 1 ]; then
    if [ ! -f "$ssl_cert" ] || [ ! -f "$ssl_key" ]; then
      create_self_signed_cert
    else
      echo "Using existing certificate files in $ssl_dir"
    fi
  elif [ -f "$ssl_cert" ] && [ -f "$ssl_key" ] && [ -d "/etc/letsencrypt/live/${domain}" ]; then
    echo "Using existing certificate files in $ssl_dir"
  else
    issue_letsencrypt
  fi

  apply_cert_permissions

  render_nginx_app_conf \
    "$(nginx_laravel_template "$(nginx_php_mode_from_conf "$APP_NGINX_CONF")" 1)" \
    "$APP_NGINX_CONF" \
    "$username" \
    "$app_name" \
    "$APP_ROOT" \
    "$php_version" \
    "$(app_http_port_from_nginx "$APP_NGINX_CONF")" \
    "$server_names" \
    "$ssl_cert" \
    "$ssl_key"
  chown "$username:$username" "$APP_NGINX_CONF"
fi

reload_nginx

sync_app_monitoring "$username" "$app_name"

echo
if [ "${replaced_self_signed:-0}" -eq 1 ]; then
  echo "Replaced the self-signed certificate with Let's Encrypt."
else
  echo "HTTPS is ready."
fi
echo "  Domain: $domain"
echo "  Cert:   $ssl_cert"
echo "  Key:    $ssl_key"
