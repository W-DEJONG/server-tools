#!/bin/bash
set -eo pipefail

usage="Usage: server-tool disable-ssh-password [-y]"
if [ $# -ne 0 ]; then
  echo "$usage"
  exit 1
fi

confirm_or_exit "This will disable SSH password logins. Only SSH key authentication will work. Do you want to proceed? (y/n): "

sshd_dir="/etc/ssh/sshd_config.d"
sshd_dropin="$sshd_dir/10-server-tool.conf"
sshd_config="/etc/ssh/sshd_config"

has_authorized_key=0
found_key_files=()
for key_file in /root/.ssh/authorized_keys /home/*/.ssh/authorized_keys; do
  [ -f "$key_file" ] || continue
  if grep -qE '^(ssh-(rsa|ed25519|dss|ecdsa)|ecdsa-sha2-|sk-ssh-)' "$key_file"; then
    has_authorized_key=1
    found_key_files+=("$key_file")
  fi
done

if [ "$has_authorized_key" -eq 0 ]; then
  echo "Error: no SSH authorized_keys found."
  echo "Add a public key to /root/.ssh/authorized_keys or a user's ~/.ssh/authorized_keys first,"
  echo "otherwise this change would lock you out of the server."
  exit 1
fi

echo "Found SSH keys in:"
for key_file in "${found_key_files[@]}"; do
  echo "  $key_file"
done

if ! command -v sshd >/dev/null 2>&1; then
  echo "Installing openssh-server..."
  apt-get -y install openssh-server
fi

mkdir -p "$sshd_dir"

if [ -f "$sshd_config" ] && ! grep -qE '^Include[[:space:]]+/etc/ssh/sshd_config\.d/\*\.conf' "$sshd_config"; then
  sed -i '1i Include /etc/ssh/sshd_config.d/*.conf' "$sshd_config"
fi

cat > "$sshd_dropin" <<'EOF'
# Managed by server-tool disable-ssh-password
PasswordAuthentication no
KbdInteractiveAuthentication no
PubkeyAuthentication yes
PermitEmptyPasswords no
EOF
chmod 644 "$sshd_dropin"

sshd -t

if systemctl is-active --quiet ssh; then
  systemctl reload ssh
elif systemctl is-active --quiet sshd; then
  systemctl reload sshd
else
  echo "SSH service is not running; the new settings apply on next start."
fi

echo
echo "SSH password logins are disabled."
echo "  Config: $sshd_dropin"
echo "Only public key authentication is accepted."
