load_app_db_env() {
  local env_file="$1"
  local line key value
  DB_CONNECTION=""
  DB_HOST=""
  DB_PORT=""
  DB_DATABASE=""
  DB_USERNAME=""
  DB_PASSWORD=""

  if [ ! -f "$env_file" ]; then
    echo "Error: database credentials file not found: $env_file"
    exit 1
  fi

  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"
    line="${line#"${line%%[![:space:]]*}"}"
    case "$line" in
      ''|\#*)
        continue
        ;;
    esac
    if [ "${line#export }" != "$line" ]; then
      line="${line#export }"
      line="${line#"${line%%[![:space:]]*}"}"
    fi
    case "$line" in
      *=*)
        ;;
      *)
        continue
        ;;
    esac
    key="${line%%=*}"
    value="${line#*=}"
    key="${key%"${key##*[![:space:]]}"}"
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    case "$value" in
      \"*\")
        value="${value#\"}"
        value="${value%\"}"
        ;;
      \'*\')
        value="${value#\'}"
        value="${value%\'}"
        ;;
    esac
    case "$key" in
      DB_CONNECTION) DB_CONNECTION="$value" ;;
      DB_HOST) DB_HOST="$value" ;;
      DB_PORT) DB_PORT="$value" ;;
      DB_DATABASE) DB_DATABASE="$value" ;;
      DB_USERNAME) DB_USERNAME="$value" ;;
      DB_PASSWORD) DB_PASSWORD="$value" ;;
    esac
  done < "$env_file"

  case "${DB_CONNECTION:-pgsql}" in
    pgsql|postgresql|postgres)
      DB_CONNECTION=pgsql
      DB_PORT="${DB_PORT:-5432}"
      ;;
    mysql|mariadb)
      DB_CONNECTION=mysql
      DB_PORT="${DB_PORT:-3306}"
      ;;
    *)
      echo "Error: unsupported database type (DB_CONNECTION=$DB_CONNECTION)."
      exit 1
      ;;
  esac

  if [ -z "$DB_HOST" ] || [ -z "$DB_DATABASE" ] || [ -z "$DB_USERNAME" ]; then
    echo "Error: $env_file is missing required DB_HOST, DB_DATABASE or DB_USERNAME."
    exit 1
  fi
}

apply_app_nginx_acl() {
  local username="$1"
  local app_root="$2"
  local user_home="/home/${username}"
  local releases="${app_root}/releases"
  local nginx_user="nginx"

  if ! command -v setfacl >/dev/null 2>&1; then
    echo "Installing acl for nginx folder permissions..."
    apt-get -y install acl
  fi

  if ! id "$nginx_user" &>/dev/null; then
    echo "Error: nginx user not found. Run: server-tool install nginx"
    exit 1
  fi

  if [ ! -d "$user_home" ]; then
    echo "Error: home directory does not exist: $user_home"
    exit 1
  fi

  if [ ! -d "$app_root" ]; then
    echo "Error: application directory does not exist: $app_root"
    exit 1
  fi

  mkdir -p "$releases"
  chown "$username:$username" "$releases"

  echo "Setting ACL permissions for $app_root"
  setfacl -m "u:${nginx_user}:--x" "$user_home"
  setfacl -m "u:${nginx_user}:--x" "$app_root"
  setfacl -R -m "u:${nginx_user}:rX" "$releases"
  setfacl -R -m "d:u:${nginx_user}:rX" "$releases"

  if [ -d "$app_root/install" ]; then
    setfacl -R -m "u:${nginx_user}:rX" "$app_root/install"
    setfacl -R -m "d:u:${nginx_user}:rX" "$app_root/install"
  fi

  if [ -d "$app_root/current" ] && [ ! -L "$app_root/current" ]; then
    setfacl -R -m "u:${nginx_user}:rX" "$app_root/current"
    setfacl -R -m "d:u:${nginx_user}:rX" "$app_root/current"
  fi

  if [ -d "$app_root/log" ]; then
    setfacl -R -m "u:${nginx_user}:rwX" "$app_root/log"
    setfacl -R -m "d:u:${nginx_user}:rwX" "$app_root/log"
  fi

  local current_index="${app_root}/current/public/index.php"
  if [ -e "$current_index" ]; then
    if sudo -u "$nginx_user" test -r "$current_index"; then
      echo "OK: ${nginx_user} can read ${current_index}"
    else
      echo "Error: ${nginx_user} cannot read ${current_index}"
      exit 1
    fi
  fi
}

php_fpm_is_installed() {
  local version="$1"
  command -v "php-fpm${version}" >/dev/null 2>&1 && [ -d "/etc/php/${version}/fpm/pool.d" ]
}

ensure_app_supervisor() {
  local username="$1"
  local app_name="$2"
  local app_root="${3:-/home/${username}/${app_name}}"

  ensure_supervisor_app_includes
  mkdir -p "$app_root/supervisor"
  chown "$username:$username" "$app_root/supervisor"
  mkdir -p /etc/supervisor/conf.d
  ln -sfn "$app_root/supervisor" "/etc/supervisor/conf.d/${username}_${app_name}.d"
}

ensure_supervisor_app_includes() {
  if [ ! -f /etc/supervisor/supervisord.conf ]; then
    apt-get -y install supervisor
  fi

  local conf="/etc/supervisor/supervisord.conf"
  local wanted='files = /etc/supervisor/conf.d/*.conf /etc/supervisor/conf.d/*.d/*.conf'

  if grep -qF "$wanted" "$conf"; then
    return 0
  fi

  if grep -qE '^[[:space:]]*files[[:space:]]*=' "$conf"; then
    sed -i 's|^[[:space:]]*files[[:space:]]*=.*|'"$wanted"'|' "$conf"
  else
    printf '\n[include]\n%s\n' "$wanted" >> "$conf"
  fi
}

reload_supervisor() {
  if ! command -v supervisorctl >/dev/null 2>&1; then
    return 0
  fi
  if systemctl is-active --quiet supervisor || systemctl is-active --quiet supervisord; then
    supervisorctl reread
    supervisorctl update
  fi
}

require_supervisor() {
  ensure_supervisor_app_includes

  if ! command -v supervisorctl >/dev/null 2>&1; then
    echo "Error: supervisorctl is not installed."
    exit 1
  fi

  if ! systemctl is-active --quiet supervisor && ! systemctl is-active --quiet supervisord; then
    if systemctl cat supervisor.service >/dev/null 2>&1; then
      systemctl enable --now supervisor
    elif systemctl cat supervisord.service >/dev/null 2>&1; then
      systemctl enable --now supervisord
    else
      echo "Error: Supervisor is not running."
      exit 1
    fi
  fi

  if ! supervisorctl status >/dev/null 2>&1; then
    echo "Error: cannot talk to the Supervisor daemon."
    exit 1
  fi
}

set_supervisor_program_autostart() {
  local conf="$1"
  local enabled="$2"

  if [ ! -f "$conf" ]; then
    echo "Error: supervisor config not found: $conf"
    exit 1
  fi

  if grep -qE '^[[:space:]]*autostart[[:space:]]*=' "$conf"; then
    sed -i 's|^[[:space:]]*autostart[[:space:]]*=.*|autostart='"$enabled"'|' "$conf"
  else
    printf 'autostart=%s\n' "$enabled" >> "$conf"
  fi

  if [ "$enabled" = "true" ]; then
    if grep -qE '^[[:space:]]*autorestart[[:space:]]*=' "$conf"; then
      sed -i 's|^[[:space:]]*autorestart[[:space:]]*=.*|autorestart=true|' "$conf"
    else
      printf 'autorestart=true\n' >> "$conf"
    fi
  fi
}

app_supervisor_conf() {
  local kind="$1"
  local app_root="$2"
  printf '%s/supervisor/%s.conf\n' "$app_root" "$kind"
}

app_supervisor_program_name() {
  local kind="$1"
  local username="$2"
  local app_name="$3"
  printf '%s-%s-%s\n' "$kind" "$username" "$app_name"
}

supervisor_ctl_group() {
  local action="$1"
  local program="$2"
  local output=""
  local status=0

  output="$(supervisorctl "$action" "${program}:*" 2>&1)" || status=$?
  if echo "$output" | grep -qi 'no such process'; then
    status=0
    output="$(supervisorctl "$action" "$program" 2>&1)" || status=$?
  fi
  printf '%s\n' "$output"

  if [ "$status" -eq 0 ]; then
    return 0
  fi

  case "$action" in
    start|restart)
      if echo "$output" | grep -qiE 'already started|spawn error'; then
        return 0
      fi
      ;;
    stop)
      if echo "$output" | grep -qiE 'not running|no such process'; then
        return 0
      fi
      ;;
  esac

  return "$status"
}

control_app_supervisor_program() {
  local action="$1"
  local kind="$2"
  local username="$3"
  local app_name="$4"
  local restart=0
  local disable=0
  local label
  local conf
  local program

  shift 4
  while [ $# -gt 0 ]; do
    case "$1" in
      --restart)
        restart=1
        shift
        ;;
      --disable)
        disable=1
        shift
        ;;
      *)
        echo "Error: unknown option '$1'"
        exit 1
        ;;
    esac
  done

  case "$kind" in
    horizon) label="Horizon" ;;
    queue) label="queue worker" ;;
    *)
      echo "Error: unknown supervisor kind '$kind'"
      exit 1
      ;;
  esac

  require_application "$username" "$app_name"

  conf="$(app_supervisor_conf "$kind" "$APP_ROOT")"
  program="$(app_supervisor_program_name "$kind" "$username" "$app_name")"

  if [ ! -f "$conf" ]; then
    echo "Error: $label is not configured for $username/$app_name."
    echo "Run: server-tool create-${kind} $username $app_name"
    exit 1
  fi

  require_supervisor
  ensure_app_supervisor "$username" "$app_name" "$APP_ROOT"

  case "$action" in
    start)
      set_supervisor_program_autostart "$conf" true
      reload_supervisor
      if [ "$restart" -eq 1 ]; then
        supervisor_ctl_group restart "$program"
      else
        supervisor_ctl_group start "$program"
      fi
      ;;
    stop)
      if [ "$disable" -eq 1 ]; then
        set_supervisor_program_autostart "$conf" false
        reload_supervisor
      fi
      supervisor_ctl_group stop "$program"
      ;;
    *)
      echo "Error: unknown supervisor action '$action'"
      exit 1
      ;;
  esac
}

collect_supervisor_program_names() {
  local conf="$1"
  sed -n 's/^\[program:\([^]]*\)]/\1/p' "$conf"
}

print_app_supervisor_jobs() {
  local kind="$1"
  local username="$2"
  local app_name="$3"
  local app_dir="$4"
  local conf
  local program

  conf="$(app_supervisor_conf "$kind" "$app_dir")"
  [ -f "$conf" ] || return 0

  while IFS= read -r program; do
    [ -n "$program" ] || continue
    printf '%s %s %s\n' "$username" "$app_name" "$program"
  done < <(collect_supervisor_program_names "$conf")
}

scan_user_app_supervisor_jobs() {
  local kind="$1"
  local username="$2"
  local user_home="/home/${username}"
  local app_dir
  local app_name

  [ -d "$user_home" ] || return 0

  for app_dir in "$user_home"/*; do
    [ -d "$app_dir" ] || continue
    app_name="$(basename "$app_dir")"

    case "$app_name" in
      ""|*/*|.|..|.ssh)
        continue
        ;;
    esac

    [ -f "${app_dir}/nginx/${app_name}.conf" ] || continue
    print_app_supervisor_jobs "$kind" "$username" "$app_name" "$app_dir"
  done
}

require_list_supervisor_user() {
  local username="$1"

  case "$username" in
    ""|*/*|root|admin|www-data|nginx|nobody|daemon)
      echo "Error: refusing to list applications for user '$username'"
      exit 1
      ;;
  esac

  if ! id "$username" &>/dev/null; then
    echo "Error: user '$username' not found."
    exit 1
  fi
}

list_app_supervisor_jobs() {
  local kind="$1"
  local filter_user="${2:-}"
  local filter_app="${3:-}"
  local user_home
  local username

  case "$kind" in
    horizon|queue) ;;
    *)
      echo "Error: unknown supervisor kind '$kind'"
      exit 1
      ;;
  esac

  if [ -n "$filter_app" ]; then
    require_application "$filter_user" "$filter_app"
  elif [ -n "$filter_user" ]; then
    require_list_supervisor_user "$filter_user"
  fi

  if [ -n "$filter_app" ]; then
    print_app_supervisor_jobs "$kind" "$filter_user" "$filter_app" "$APP_ROOT"
  elif [ -n "$filter_user" ]; then
    scan_user_app_supervisor_jobs "$kind" "$filter_user"
  elif [ -d /home ]; then
    for user_home in /home/*; do
      [ -d "$user_home" ] || continue
      username="$(basename "$user_home")"
      case "$username" in
        ""|*/*|root|admin|www-data|nginx|nobody|daemon)
          continue
          ;;
      esac
      scan_user_app_supervisor_jobs "$kind" "$username"
    done
  fi | sort
}

list_app_supervisor_jobs_both() {
  local filter_user="${1:-}"
  local filter_app="${2:-}"
  {
    list_app_supervisor_jobs horizon "$filter_user" "$filter_app"
    list_app_supervisor_jobs queue "$filter_user" "$filter_app"
  } | sort
}

ensure_cron() {
  if ! command -v crontab >/dev/null 2>&1; then
    apt-get -y install cron
  fi
}

current_user_crontab() {
  local username="$1"
  crontab -u "$username" -l 2>/dev/null || true
}

strip_app_crontab_block() {
  local username="$1"
  local app_name="$2"
  local begin="# BEGIN server-tool app: ${username}/${app_name}"
  local end="# END server-tool app: ${username}/${app_name}"

  awk -v begin="$begin" -v end="$end" '
    $0 == begin { skip=1; next }
    $0 == end { skip=0; next }
    !skip
  '
}

crontab_is_empty() {
  [ -z "$(printf '%s' "$1" | grep -v '^[[:space:]]*$' || true)" ]
}

install_user_crontab() {
  local username="$1"
  local content="$2"

  if crontab_is_empty "$content"; then
    crontab -u "$username" -r 2>/dev/null || true
    return 0
  fi

  printf '%s\n' "$content" | crontab -u "$username" -
}

collect_app_cron_jobs() {
  local cron_dir="$1"
  local file
  local jobs=""

  if [ ! -d "$cron_dir" ]; then
    printf ''
    return 0
  fi

  while IFS= read -r -d '' file; do
    jobs+="$(cat "$file")"
    jobs+=$'\n'
  done < <(find "$cron_dir" -maxdepth 1 -type f ! -name '.*' -print0 | sort -z)

  if crontab_is_empty "$jobs"; then
    printf ''
    return 0
  fi

  printf '%s' "$jobs"
}

apply_app_crontab() {
  local username="$1"
  local app_name="$2"
  local app_root="${3:-/home/${username}/${app_name}}"
  local begin="# BEGIN server-tool app: ${username}/${app_name}"
  local end="# END server-tool app: ${username}/${app_name}"
  local current
  local jobs
  local new=""

  ensure_cron
  current="$(current_user_crontab "$username" | strip_app_crontab_block "$username" "$app_name")"
  jobs="$(collect_app_cron_jobs "$app_root/cron")"

  if ! crontab_is_empty "$current"; then
    new="$current"
    if [ "${new: -1}" != $'\n' ]; then
      new+=$'\n'
    fi
  fi

  if [ -n "$jobs" ]; then
    if [ -n "$new" ]; then
      new+=$'\n'
    fi
    new+="$begin"$'\n'
    new+="$jobs"
    if [ "${jobs: -1}" != $'\n' ]; then
      new+=$'\n'
    fi
    new+="$end"$'\n'
  fi

  install_user_crontab "$username" "$new"
}

remove_app_crontab() {
  local username="$1"
  local app_name="$2"
  local current

  if ! command -v crontab >/dev/null 2>&1; then
    return 0
  fi
  if ! id "$username" &>/dev/null; then
    return 0
  fi

  current="$(current_user_crontab "$username" | strip_app_crontab_block "$username" "$app_name")"
  install_user_crontab "$username" "$current"
}

