ensure_sury_php_repo() {
  apt-get update
  apt-get -y install lsb-release ca-certificates curl
  curl -sSLo /tmp/debsuryorg-archive-keyring.deb https://packages.sury.org/debsuryorg-archive-keyring.deb
  dpkg -i /tmp/debsuryorg-archive-keyring.deb
  rm -f /tmp/debsuryorg-archive-keyring.deb
  echo "deb [signed-by=/usr/share/keyrings/debsuryorg-archive-keyring.gpg] https://packages.sury.org/php/ $(debian_codename) main" > /etc/apt/sources.list.d/php.list
  # Replace the previous trusted.gpg.d key drop used on older installs
  rm -f /etc/apt/trusted.gpg.d/php.gpg
  apt-get update
}

NODEJS_ROOT="/usr/local/lib/nodejs"

nodejs_is_installed() {
  local major="$1"
  [ -x "$NODEJS_ROOT/$major/bin/node" ]
}

nodejs_platform() {
  local arch
  arch="$(debian_arch)"
  case "$arch" in
    amd64)
      printf '%s\n' "linux-x64"
      ;;
    arm64)
      printf '%s\n' "linux-arm64"
      ;;
    *)
      echo "Error: Node.js binaries are only available for amd64 and arm64. Detected: $arch"
      exit 1
      ;;
  esac
}

installed_nodejs_majors() {
  local d name
  if [ ! -d "$NODEJS_ROOT" ]; then
    return 0
  fi

  for d in "$NODEJS_ROOT"/*; do
    [ -e "$d" ] || continue
    name="$(basename "$d")"
    [ "$name" = "default" ] && continue
    if [ -x "$d/bin/node" ]; then
      printf '%s\n' "$name"
    fi
  done | sort -n
}

list_installed_nodejs_majors() {
  local majors
  majors="$(installed_nodejs_majors | tr '\n' ' ')"
  majors="${majors% }"
  if [ -z "$majors" ]; then
    printf '%s\n' "(none)"
  else
    printf '%s\n' "$majors"
  fi
}

remove_nodesource_nodejs() {
  if package_is_installed nodejs; then
    echo "Removing apt nodejs so versioned Node.js installs can take over..."
    apt-get remove -y nodejs
  fi

  rm -f /etc/apt/sources.list.d/nodesource.sources
  rm -f /etc/apt/sources.list.d/nodesource.list
  rm -f /etc/apt/preferences.d/nodejs
  rm -f /usr/share/keyrings/nodesource.gpg
}

install_nodejs_version() {
  local major="$1"
  local platform tarball expected actual tmpdir base_url

  if nodejs_is_installed "$major"; then
    echo "Node.js $major is already installed."
    return 0
  fi

  platform="$(nodejs_platform)"
  apt-get update
  apt-get -y install ca-certificates curl xz-utils

  base_url="https://nodejs.org/dist/latest-v${major}.x"
  tmpdir="$(mktemp -d)"
  curl -fsSL -o "$tmpdir/SHASUMS256.txt" "${base_url}/SHASUMS256.txt"
  tarball="$(awk -v p="$platform" '
    $2 ~ ("^node-v[0-9.]+-" p "[.]tar[.]xz$") { print $2; exit }
  ' "$tmpdir/SHASUMS256.txt")"

  if [ -z "$tarball" ]; then
    rm -rf "$tmpdir"
    echo "Error: could not find a Node.js $major tarball for $platform."
    exit 1
  fi

  expected="$(awk -v t="$tarball" '$2 == t { print $1; exit }' "$tmpdir/SHASUMS256.txt")"
  if [ -z "$expected" ]; then
    rm -rf "$tmpdir"
    echo "Error: could not find checksum for $tarball."
    exit 1
  fi

  echo "Downloading $tarball..."
  curl -fsSL -o "$tmpdir/$tarball" "${base_url}/${tarball}"
  actual="$(sha256sum "$tmpdir/$tarball" | awk '{print $1}')"
  if [ "$actual" != "$expected" ]; then
    rm -rf "$tmpdir"
    echo "Error: checksum mismatch for $tarball."
    exit 1
  fi

  mkdir -p "$tmpdir/extract"
  tar -xJf "$tmpdir/$tarball" --strip-components=1 -C "$tmpdir/extract"
  mkdir -p "$NODEJS_ROOT"
  rm -rf "${NODEJS_ROOT:?}/$major"
  mv "$tmpdir/extract" "$NODEJS_ROOT/$major"
  rm -rf "$tmpdir"

  echo "Installed Node.js $major ($tarball)."
}

update_nodejs_default_symlink() {
  local best="" v

  read_versions_from_file "$SERVER_TOOL_ROOT/templates/node-versions"
  for v in "${ALLOWED_VERSIONS[@]}"; do
    if nodejs_is_installed "$v"; then
      if [ -z "$best" ] || [ "$v" -gt "$best" ]; then
        best="$v"
      fi
    fi
  done

  if [ -z "$best" ]; then
    echo "Error: no Node.js versions are installed."
    exit 1
  fi

  mkdir -p "$NODEJS_ROOT"
  ln -sfn "$best" "$NODEJS_ROOT/default"
}

ensure_node_wrappers() {
  mkdir -p /usr/local/bin
  chmod +x "$SERVER_TOOL_ROOT/bin/node-cmd"
  ln -sfn "$SERVER_TOOL_ROOT/bin/node-cmd" /usr/local/bin/node
  ln -sfn "$SERVER_TOOL_ROOT/bin/node-cmd" /usr/local/bin/npm
  ln -sfn "$SERVER_TOOL_ROOT/bin/node-cmd" /usr/local/bin/npx
}

find_nvmrc() {
  local dir="$PWD"

  while true; do
    if [ -f "$dir/.nvmrc" ]; then
      printf '%s\n' "$dir/.nvmrc"
      return 0
    fi
    if [ "$dir" = "/" ]; then
      break
    fi
    dir="$(dirname "$dir")"
  done

  return 1
}

parse_nvmrc_major() {
  local file="$1"
  local line

  while IFS= read -r line || [ -n "$line" ]; do
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [ -n "$line" ] || continue
    line="${line#v}"
    line="${line#V}"
    if [[ "$line" =~ ^([0-9]+)([.][0-9]+)*$ ]]; then
      printf '%s\n' "${BASH_REMATCH[1]}"
      return 0
    fi
    echo "Error: invalid .nvmrc value '$line' in $file" >&2
    echo "Expected a Node.js major version such as 22 or 22.14.0." >&2
    exit 1
  done < "$file"

  echo "Error: .nvmrc is empty: $file" >&2
  exit 1
}

resolve_active_node_version() {
  local nvmrc major

  if nvmrc="$(find_nvmrc)"; then
    major="$(parse_nvmrc_major "$nvmrc")"
    if ! nodejs_is_installed "$major"; then
      echo "Error: Node.js $major from $nvmrc is not installed." >&2
      echo "Installed versions: $(list_installed_nodejs_majors)" >&2
      echo "Run: server-tool install npm -y $major" >&2
      exit 1
    fi
    printf '%s\n' "$major"
    return 0
  fi

  if [ -e "$NODEJS_ROOT/default/bin/node" ]; then
    major="$(basename "$(readlink -f "$NODEJS_ROOT/default")")"
    printf '%s\n' "$major"
    return 0
  fi

  echo "Error: Node.js is not installed. Run: server-tool install npm" >&2
  exit 1
}

exec_nodejs() {
  local cmd="$1"
  shift
  local version root

  version="$(resolve_active_node_version)"
  root="$NODEJS_ROOT/$version"

  case "$cmd" in
    node)
      exec "$root/bin/node" "$@"
      ;;
    npm)
      exec "$root/bin/node" "$root/lib/node_modules/npm/bin/npm-cli.js" "$@"
      ;;
    npx)
      exec "$root/bin/node" "$root/lib/node_modules/npm/bin/npx-cli.js" "$@"
      ;;
    *)
      echo "Error: unknown Node.js command '$cmd'" >&2
      exit 1
      ;;
  esac
}

ensure_pgdg_repo() {
  local arch

  arch="$(debian_arch)"
  apt-get -y install curl ca-certificates
  install -d /usr/share/postgresql-common/pgdg
  curl -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc --fail https://www.postgresql.org/media/keys/ACCC4CF8.asc

  cat > /etc/apt/sources.list.d/pgdg.sources <<EOF
Types: deb
URIs: https://apt.postgresql.org/pub/repos/apt
Suites: $(debian_codename)-pgdg
Architectures: ${arch}
Components: main
Signed-By: /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc
EOF

  apt-get update
}

ensure_redis_repo() {
  apt-get -y install lsb-release curl gpg
  mkdir -p /usr/share/keyrings
  curl -fsSL https://packages.redis.io/gpg | gpg --dearmor | tee /usr/share/keyrings/redis-archive-keyring.gpg >/dev/null
  chmod 644 /usr/share/keyrings/redis-archive-keyring.gpg
  echo "deb [signed-by=/usr/share/keyrings/redis-archive-keyring.gpg] https://packages.redis.io/deb $(debian_codename) main" > /etc/apt/sources.list.d/redis.list
  if ! apt-get update; then
    echo "Official Redis repo is not available for $(debian_codename); falling back to Debian packages."
    rm -f /etc/apt/sources.list.d/redis.list
    apt-get update
  fi
}

ensure_mariadb_repo() {
  apt-get -y install curl ca-certificates
  curl -LsS https://r.mariadb.com/downloads/mariadb_repo_setup | bash -s -- --mariadb-server-version=mariadb-11.8 --skip-maxscale --skip-tools
}

write_mysql_sources_list() {
  local suite="$1"
  cat > /etc/apt/sources.list.d/mysql.list <<EOF
deb [signed-by=/usr/share/keyrings/mysql.gpg] https://repo.mysql.com/apt/debian ${suite} mysql-8.4-lts
EOF
}

install_mysql_keyring() {
  local tmp

  mkdir -p /usr/share/keyrings
  tmp="$(mktemp)"
  curl -fsSL https://repo.mysql.com/RPM-GPG-KEY-mysql-2025 | gpg --batch --dearmor > "$tmp"
  chmod 644 "$tmp"
  mv "$tmp" /usr/share/keyrings/mysql.gpg
}

ensure_mysql_repo() {
  local suite

  apt-get -y install curl gnupg ca-certificates
  install_mysql_keyring

  suite="$(debian_codename)"
  write_mysql_sources_list "$suite"
  if ! apt-get update; then
    if [ "$suite" != "bookworm" ]; then
      echo "Official MySQL repo is not available for $suite; falling back to bookworm."
      write_mysql_sources_list bookworm
      apt-get update
    else
      echo "Error: failed to update package lists from the MySQL repository."
      exit 1
    fi
  fi
}

ensure_meilisearch_repo() {
  apt-get -y install ca-certificates
  echo "deb [trusted=yes] https://apt.fury.io/meilisearch/ /" > /etc/apt/sources.list.d/meilisearch.list
  apt-get update
}

ensure_nginx_repo() {
  apt-get -y install curl gnupg2 ca-certificates lsb-release debian-archive-keyring
  mkdir -p /usr/share/keyrings
  curl -fsSL https://nginx.org/keys/nginx_signing.key | gpg --dearmor | tee /usr/share/keyrings/nginx-archive-keyring.gpg >/dev/null
  echo "deb [signed-by=/usr/share/keyrings/nginx-archive-keyring.gpg] https://nginx.org/packages/debian $(debian_codename) nginx" > /etc/apt/sources.list.d/nginx.list
  printf 'Package: *\nPin: origin nginx.org\nPin: release o=nginx\nPin-Priority: 900\n' > /etc/apt/preferences.d/99nginx
  apt-get update
}

BACKUP_CONFIG_FILE="/etc/server-tool/backup.conf"

validate_s3_bucket_name() {
  local name="$1"

  case "$name" in
    ""|*/*|*" "*|*[[:space:]]*)
      echo "Error: invalid S3 bucket name '$name'"
      exit 1
      ;;
  esac
}

write_backup_config() {
  local bucket="$1"
  local region=""
  local server=""

  validate_s3_bucket_name "$bucket"

  mkdir -p "$(dirname "$BACKUP_CONFIG_FILE")"
  if [ -f "$BACKUP_CONFIG_FILE" ]; then
    region="$(sed -n 's/^S3_REGION=//p' "$BACKUP_CONFIG_FILE" | head -1)"
    server="$(sed -n 's/^SERVER_NAME=//p' "$BACKUP_CONFIG_FILE" | head -1)"
  fi

  {
    echo "S3_BUCKET=$bucket"
    if [ -n "$region" ]; then
      echo "S3_REGION=$region"
    fi
    if [ -n "$server" ]; then
      echo "SERVER_NAME=$server"
    fi
  } > "$BACKUP_CONFIG_FILE"
  chmod 640 "$BACKUP_CONFIG_FILE"
}

load_backup_config() {
  S3_BUCKET=""
  S3_REGION=""
  SERVER_NAME=""

  if [ ! -f "$BACKUP_CONFIG_FILE" ]; then
    echo "Error: backup config not found: $BACKUP_CONFIG_FILE"
    echo "Run: server-tool install aws [<bucket>]"
    exit 1
  fi

  # shellcheck disable=SC1090
  source "$BACKUP_CONFIG_FILE"

  if [ -z "${S3_BUCKET:-}" ]; then
    echo "Error: S3_BUCKET is not set in $BACKUP_CONFIG_FILE"
    echo "Run: server-tool install aws [<bucket>]"
    exit 1
  fi

  validate_s3_bucket_name "$S3_BUCKET"

  if [ -z "${SERVER_NAME:-}" ]; then
    SERVER_NAME="$(hostname -s)"
  fi
}

require_aws_cli() {
  if ! command -v aws >/dev/null 2>&1; then
    echo "Error: aws is not installed. Run: server-tool install aws [<bucket>]"
    exit 1
  fi
}

cron_d_safe_name() {
  local original="$1"
  local name

  name="$(printf '%s' "$original" | tr -c 'A-Za-z0-9-' '-')"
  name="$(printf '%s' "$name" | sed 's/--*/-/g')"
  name="${name#-}"
  name="${name%-}"

  if [ -z "$name" ]; then
    echo "Error: '$original' cannot be used in a /etc/cron.d/ filename"
    exit 1
  fi

  printf '%s\n' "$name"
}

app_backup_cron_file() {
  local username
  local app_name
  username="$(cron_d_safe_name "$1")"
  app_name="$(cron_d_safe_name "$2")"
  printf '/etc/cron.d/server-tool-backup-%s-%s\n' "$username" "$app_name"
}

certbot_timer_unit_exists() {
  systemctl cat certbot.timer >/dev/null 2>&1
}

list_certbot_deploy_hooks() {
  local hook_dir="/etc/letsencrypt/renewal-hooks/deploy"
  local f
  local hooks=()

  if [ ! -d "$hook_dir" ]; then
    return 0
  fi

  for f in "$hook_dir"/*; do
    [ -f "$f" ] || continue
    hooks+=("$(basename "$f")")
  done

  if [ ${#hooks[@]} -eq 0 ]; then
    return 0
  fi

  echo "Deploy hooks:"
  printf '  %s\n' "${hooks[@]}"
}

ensure_certbot_autorenew() {
  if ! command -v certbot >/dev/null 2>&1; then
    echo "Error: certbot is not installed. Run: server-tool install nginx"
    exit 1
  fi

  if certbot_timer_unit_exists; then
    if ! systemctl is-enabled --quiet certbot.timer || ! systemctl is-active --quiet certbot.timer; then
      confirm_or_exit "Certbot auto-renew is not active. Enable certbot.timer? (y/n): "
      systemctl enable --now certbot.timer
    fi
    echo "Certbot auto-renew: certbot.timer $(systemctl is-enabled certbot.timer 2>/dev/null), $(systemctl is-active certbot.timer 2>/dev/null)"
  elif [ -f /etc/cron.d/certbot ]; then
    echo "Certbot auto-renew: /etc/cron.d/certbot"
  else
    echo "Error: certbot auto-renew is not configured (no certbot.timer or /etc/cron.d/certbot)."
    exit 1
  fi

  list_certbot_deploy_hooks
}
