#!/bin/bash

require_supported_debian() {
  if [ ! -f /etc/os-release ]; then
    echo "Error: cannot determine OS. This tool requires Debian 12 (bookworm) or Debian 13 (trixie)."
    exit 1
  fi

  # shellcheck disable=SC1091
  . /etc/os-release

  if [ "${ID:-}" != "debian" ]; then
    echo "Error: this tool only supports Debian. Detected: ${ID:-unknown}."
    exit 1
  fi

  case "${VERSION_CODENAME:-}" in
    bookworm|trixie)
      ;;
    *)
      echo "Error: Debian ${VERSION_CODENAME:-unknown} is not supported."
      echo "Supported releases: Debian 12 (bookworm) and Debian 13 (trixie)."
      exit 1
      ;;
  esac
}

debian_codename() {
  # shellcheck disable=SC1091
  . /etc/os-release
  printf '%s\n' "$VERSION_CODENAME"
}

debian_arch() {
  dpkg --print-architecture
}

confirm_or_exit() {
  local message="$1"
  if [ "${ASSUME_YES:-0}" = "1" ]; then
    return 0
  fi

  local confirm
  read -r -p "$message" confirm
  if [ "$confirm" != "y" ]; then
    echo "Script execution aborted."
    exit 0
  fi
}

ensure_login_bashrc() {
  local bashrc="$1"
  local with_become="${2:-0}"
  local bashrc_dir

  bashrc_dir="$(dirname "$bashrc")"
  if [ ! -d "$bashrc_dir" ]; then
    return 0
  fi

  touch "$bashrc"

  if ! grep -qxF "export LS_OPTIONS='--color=auto'" "$bashrc"; then
    cat >> "$bashrc" <<'EOF'
export LS_OPTIONS='--color=auto'
eval "$(dircolors)"
alias ls='ls $LS_OPTIONS'
alias ll='ls $LS_OPTIONS -l'
alias l='ls $LS_OPTIONS -lA'
EOF
  fi

  if [ "$with_become" = "1" ] && ! grep -qxF "alias become='sudo su -l'" "$bashrc"; then
    echo "alias become='sudo su -l'" >> "$bashrc"
  fi
}

require_application() {
  local username="$1"
  local app_name="$2"

  case "$username" in
    ""|*/*|root|admin|www-data|nginx|nobody|daemon)
      echo "Error: refusing to change an application for user '$username'"
      exit 1
      ;;
  esac

  case "$app_name" in
    ""|*/*|.|..|.ssh)
      echo "Error: invalid application name '$app_name'"
      exit 1
      ;;
  esac

  if ! id "$username" &>/dev/null; then
    echo "Error: user '$username' not found."
    exit 1
  fi

  APP_ROOT="/home/${username}/${app_name}"
  APP_NGINX_CONF="${APP_ROOT}/nginx/${app_name}.conf"

  if [ ! -d "$APP_ROOT" ] || [ ! -f "$APP_NGINX_CONF" ]; then
    echo "Error: application '$app_name' for user '$username' not found."
    exit 1
  fi
}

app_php_version_from_nginx() {
  local conf="$1"
  sed -n 's|.*unix:/run/php/php\([0-9][0-9.]*\)-fpm-.*|\1|p' "$conf" | head -1
}

app_server_name_from_nginx() {
  local conf="$1"
  sed -n 's/^[[:space:]]*server_name[[:space:]]*\([^;[:space:]]*\).*/\1/p' "$conf" | head -1
}

app_server_names_from_nginx() {
  local conf="$1"
  awk '
    /^[[:space:]]*server_name[[:space:]]+/ {
      line = $0
      sub(/^[[:space:]]*server_name[[:space:]]+/, "", line)
      sub(/;.*/, "", line)
      n = split(line, names, /[[:space:]]+/)
      for (i = 1; i <= n; i++) {
        if (names[i] != "" && !seen[names[i]]++) {
          if (out != "") out = out " "
          out = out names[i]
        }
      }
    }
    END { print out }
  ' "$conf"
}

require_valid_domain() {
  if ! [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]]; then
    echo "Error: invalid domain '$1'"
    exit 1
  fi
}

name_is_in_list() {
  local needle="$1"
  local names="$2"
  local token
  for token in $names; do
    if [ "$token" = "$needle" ]; then
      return 0
    fi
  done
  return 1
}

append_unique_name() {
  local names="$1"
  local token="$2"
  if [ -z "$token" ]; then
    printf '%s\n' "$names"
    return 0
  fi
  if name_is_in_list "$token" "$names"; then
    printf '%s\n' "$names"
    return 0
  fi
  if [ -n "$names" ]; then
    printf '%s %s\n' "$names" "$token"
  else
    printf '%s\n' "$token"
  fi
}

remove_name_from_list() {
  local names="$1"
  local needle="$2"
  local out="" token
  for token in $names; do
    if [ "$token" = "$needle" ]; then
      continue
    fi
    if [ -n "$out" ]; then
      out="${out} ${token}"
    else
      out="$token"
    fi
  done
  printf '%s\n' "$out"
}

count_names() {
  local names="$1"
  local n=0 token
  for token in $names; do
    n=$((n + 1))
  done
  printf '%s\n' "$n"
}

set_nginx_server_names() {
  local conf="$1"
  local names="$2"
  local tmp
  if [ -z "$names" ]; then
    echo "Error: server_name list cannot be empty."
    exit 1
  fi
  tmp="${conf}.tmp.$$"
  awk -v names="$names" '
    /^[[:space:]]*server_name[[:space:]]+/ {
      match($0, /^[[:space:]]*/)
      print substr($0, RSTART, RLENGTH) "server_name " names ";"
      next
    }
    { print }
  ' "$conf" > "$tmp"
  mv "$tmp" "$conf"
}

app_ssl_cert_from_nginx() {
  local conf="$1"
  sed -n 's/^[[:space:]]*ssl_certificate[[:space:]]*\([^;[:space:]]*\).*/\1/p' "$conf" | head -1
}

app_ssl_key_from_nginx() {
  local conf="$1"
  sed -n 's/^[[:space:]]*ssl_certificate_key[[:space:]]*\([^;[:space:]]*\).*/\1/p' "$conf" | head -1
}

app_letsencrypt_lineage() {
  local conf="$1"
  local cert lineage name
  cert="$(app_ssl_cert_from_nginx "$conf")"
  if [ -n "$cert" ]; then
    lineage="$(basename "$cert")"
    lineage="${lineage%.pem}"
    if [ -d "/etc/letsencrypt/live/${lineage}" ]; then
      printf '%s\n' "$lineage"
      return 0
    fi
  fi
  for name in $(app_server_names_from_nginx "$conf"); do
    if [ -d "/etc/letsencrypt/live/${name}" ]; then
      printf '%s\n' "$name"
      return 0
    fi
  done
  return 1
}

request_letsencrypt_names() {
  local lineage="$1"
  local webroot="$2"
  local mode="$3"
  local email="$4"
  shift 4

  if [ $# -lt 1 ]; then
    echo "Error: at least one domain is required for Let's Encrypt."
    exit 1
  fi

  if ! command -v certbot >/dev/null 2>&1; then
    echo "Error: certbot is not installed. Run: server-tool install nginx"
    exit 1
  fi

  local certbot_args=(certonly --webroot -w "$webroot" --cert-name "$lineage" --non-interactive --agree-tos)
  case "$mode" in
    issue)
      ;;
    expand)
      certbot_args+=(--expand)
      ;;
    replace)
      certbot_args+=(--force-renewal)
      ;;
    *)
      echo "Error: unknown Let's Encrypt mode '$mode'."
      exit 1
      ;;
  esac

  if [ -n "$email" ]; then
    certbot_args+=(--email "$email")
  else
    certbot_args+=(--register-unsafely-without-email)
  fi

  local name
  for name in "$@"; do
    certbot_args+=(-d "$name")
  done

  echo "Requesting Let's Encrypt certificate..."
  certbot "${certbot_args[@]}"
}

copy_letsencrypt_to_app() {
  local lineage="$1"
  local ssl_cert="$2"
  local ssl_key="$3"
  cp "/etc/letsencrypt/live/${lineage}/fullchain.pem" "$ssl_cert"
  cp "/etc/letsencrypt/live/${lineage}/privkey.pem" "$ssl_key"
}

write_letsencrypt_deploy_hook() {
  local username="$1"
  local app_name="$2"
  local lineage="$3"
  local ssl_cert="$4"
  local ssl_key="$5"
  local hook_dir="/etc/letsencrypt/renewal-hooks/deploy"
  mkdir -p "$hook_dir"
  cat > "${hook_dir}/${username}_${app_name}.sh" <<EOF
#!/bin/bash
cp "/etc/letsencrypt/live/${lineage}/fullchain.pem" "$ssl_cert"
cp "/etc/letsencrypt/live/${lineage}/privkey.pem" "$ssl_key"
nginx -s reload
EOF
  chmod 750 "${hook_dir}/${username}_${app_name}.sh"
}

sync_app_letsencrypt_names() {
  local username="$1"
  local app_name="$2"
  local app_root="$3"
  local lineage="$4"
  local ssl_cert="$5"
  local ssl_key="$6"
  local mode="$7"
  local email="$8"
  shift 8

  request_letsencrypt_names "$lineage" "$app_root/current/public" "$mode" "$email" "$@"
  copy_letsencrypt_to_app "$lineage" "$ssl_cert" "$ssl_key"
  write_letsencrypt_deploy_hook "$username" "$app_name" "$lineage" "$ssl_cert" "$ssl_key"
  chmod 640 "$ssl_cert" "$ssl_key"
  chown "$username:$username" "$(dirname "$ssl_cert")" "$ssl_cert" "$ssl_key"
  ensure_certbot_autorenew
}

render_nginx_app_conf() {
  local template="$1"
  local dest="$2"
  local username="$3"
  local app_name="$4"
  local app_root="$5"
  local php_version="$6"
  local server_name="$7"
  local ssl_cert="${8:-}"
  local ssl_key="${9:-}"

  sed -e "s|{{USERNAME}}|$username|g" \
      -e "s|{{APP_NAME}}|$app_name|g" \
      -e "s|{{APP_ROOT}}|$app_root|g" \
      -e "s|{{PHP_VERSION}}|$php_version|g" \
      -e "s|{{SERVER_NAME}}|$server_name|g" \
      -e "s|{{SSL_CERT}}|$ssl_cert|g" \
      -e "s|{{SSL_KEY}}|$ssl_key|g" \
      "$template" > "$dest"
}

reload_nginx() {
  nginx -t
  nginx -s reload
}

auth_basic_var_name() {
  local username="$1"
  local app_name="$2"
  local raw

  raw="$(printf '%s' "${username}_${app_name}" | tr -c 'A-Za-z0-9' '_')"
  printf 'auth_basic_%s\n' "$raw"
}

read_versions_from_file() {
  local file="$1"
  local line
  ALLOWED_VERSIONS=()

  while IFS= read -r line; do
    [ -n "$line" ] || continue
    ALLOWED_VERSIONS+=("$line")
  done < "$file"

  if [ ${#ALLOWED_VERSIONS[@]} -eq 0 ]; then
    echo "Error: no versions found in $file"
    exit 1
  fi
}

version_is_allowed() {
  local candidate="$1"
  local allowed
  for allowed in "${ALLOWED_VERSIONS[@]}"; do
    if [ "$candidate" = "$allowed" ]; then
      return 0
    fi
  done
  return 1
}

select_version_from_file() {
  local prompt="$1"
  local file="$2"

  read_versions_from_file "$file"

  PS3="$prompt"
  select version in "${ALLOWED_VERSIONS[@]}"; do
    if [ -n "$version" ]; then
      SELECTED_VERSION="$version"
      return 0
    fi
    echo "Invalid selection."
  done
}

# resolve_versions <versions-file> <prompt> <allow_multiple 0|1> [version ...]
resolve_versions() {
  local file="$1"
  local prompt="$2"
  local allow_multiple="$3"
  shift 3

  read_versions_from_file "$file"
  SELECTED_VERSIONS=()

  if [ $# -gt 0 ]; then
    local requested
    for requested in "$@"; do
      if ! version_is_allowed "$requested"; then
        echo "Error: unsupported version '$requested'."
        echo "Available versions: ${ALLOWED_VERSIONS[*]}"
        exit 1
      fi
      SELECTED_VERSIONS+=("$requested")
    done
  else
    select_version_from_file "$prompt" "$file"
    SELECTED_VERSIONS=("$SELECTED_VERSION")
  fi

  if [ "$allow_multiple" != "1" ] && [ ${#SELECTED_VERSIONS[@]} -gt 1 ]; then
    echo "Error: this package accepts only one version."
    echo "Available versions: ${ALLOWED_VERSIONS[*]}"
    exit 1
  fi

  SELECTED_VERSION="${SELECTED_VERSIONS[0]}"
}

package_is_installed() {
  local status
  status="$(dpkg-query -W -f='${Status}' "$1" 2>/dev/null || true)"
  [ "$status" = "install ok installed" ]
}

postgres_client_available() {
  command -v psql >/dev/null 2>&1
}

mysql_client_available() {
  command -v mysql >/dev/null 2>&1 || command -v mariadb >/dev/null 2>&1
}

postgres_available() {
  postgres_client_available && id postgres &>/dev/null && systemctl is-active --quiet postgresql
}

mysql_available() {
  mysql_client_available && \
    { systemctl is-active --quiet mariadb || systemctl is-active --quiet mysql; }
}

db_admin_is_remote() {
  [ -n "${DB_ADMIN_HOST:-}" ]
}

mariadb_server_present() {
  package_is_installed mariadb-server || systemctl is-active --quiet mariadb
}

mysql_server_present() {
  package_is_installed mysql-community-server
}

refuse_if_mariadb_installed() {
  if mariadb_server_present || package_is_installed mariadb-client; then
    echo "Error: MariaDB is already installed. MySQL and MariaDB cannot be installed together."
    exit 1
  fi
}

refuse_if_mysql_installed() {
  if mysql_server_present || package_is_installed mysql-community-client; then
    echo "Error: MySQL is already installed. MySQL and MariaDB cannot be installed together."
    exit 1
  fi
}

normalize_db_type() {
  case "$1" in
    pgsql|postgresql|postgres)
      printf '%s\n' pgsql
      ;;
    mysql|mariadb)
      printf '%s\n' mysql
      ;;
    *)
      printf '%s\n' ''
      ;;
  esac
}

db_type_label() {
  case "${1:-$SELECTED_DB_TYPE}" in
    pgsql) printf '%s\n' PostgreSQL ;;
    mysql) printf '%s\n' MySQL ;;
    *) printf '%s\n' Database ;;
  esac
}

db_default_port() {
  case "${1:-$SELECTED_DB_TYPE}" in
    mysql) printf '%s\n' 3306 ;;
    *) printf '%s\n' 5432 ;;
  esac
}

# resolve_db_type [requested]
# When DB_ADMIN_HOST is set, a client is enough; otherwise a local server must be running.
resolve_db_type() {
  local requested
  local pg_ok=0
  local mysql_ok=0
  local remote=0
  SELECTED_DB_TYPE=""

  requested="$(normalize_db_type "${1:-}")"

  if [ -n "${1:-}" ] && [ -z "$requested" ]; then
    echo "Error: unsupported database type '$1'. Use pgsql or mysql."
    exit 1
  fi

  if db_admin_is_remote; then
    remote=1
  fi

  if [ "$remote" -eq 1 ]; then
    if postgres_client_available; then
      pg_ok=1
    fi
    if mysql_client_available; then
      mysql_ok=1
    fi
  else
    if postgres_available; then
      pg_ok=1
    fi
    if mysql_available; then
      mysql_ok=1
    fi
  fi

  if [ -n "$requested" ]; then
    if [ "$requested" = "pgsql" ] && [ "$pg_ok" -ne 1 ]; then
      if [ "$remote" -eq 1 ]; then
        echo "Error: psql is not installed. Run: server-tool install postgresql"
      else
        echo "Error: PostgreSQL is not installed or not running. Run: server-tool install postgresql"
      fi
      exit 1
    fi
    if [ "$requested" = "mysql" ] && [ "$mysql_ok" -ne 1 ]; then
      if [ "$remote" -eq 1 ]; then
        echo "Error: MySQL/MariaDB client is not installed. Run: server-tool install mysql-client or server-tool install mariadb-client"
      else
        echo "Error: MySQL/MariaDB is not installed or not running. Run: server-tool install mysql or server-tool install mariadb-server"
      fi
      exit 1
    fi
    SELECTED_DB_TYPE="$requested"
    return 0
  fi

  if [ "$pg_ok" -eq 1 ] && [ "$mysql_ok" -eq 0 ]; then
    SELECTED_DB_TYPE=pgsql
    return 0
  fi
  if [ "$mysql_ok" -eq 1 ] && [ "$pg_ok" -eq 0 ]; then
    SELECTED_DB_TYPE=mysql
    return 0
  fi
  if [ "$pg_ok" -eq 0 ] && [ "$mysql_ok" -eq 0 ]; then
    if [ "$remote" -eq 1 ]; then
      echo "Error: no database client is installed."
      echo "Install one of: server-tool install postgresql, server-tool install mysql-client, server-tool install mariadb-client"
    else
      echo "Error: no database server is installed."
      echo "Install one of: server-tool install postgresql, server-tool install mysql, server-tool install mariadb-server"
    fi
    exit 1
  fi

  if [ "${ASSUME_YES:-0}" = "1" ]; then
    if [ "$remote" -eq 1 ]; then
      echo "Error: both PostgreSQL and MySQL clients are available. Specify -t pgsql or -t mysql."
    else
      echo "Error: both PostgreSQL and MySQL/MariaDB are installed. Specify -t pgsql or -t mysql."
    fi
    exit 1
  fi

  local choice
  PS3="Which database should be used? "
  select choice in PostgreSQL MySQL; do
    case "$choice" in
      PostgreSQL)
        SELECTED_DB_TYPE=pgsql
        return 0
        ;;
      MySQL)
        SELECTED_DB_TYPE=mysql
        return 0
        ;;
    esac
    echo "Invalid selection."
  done
}

# try_parse_remote_db_option -- consume --host/--port/--admin-* /--user-host
# Sets CONSUMED to the number of args used. Return 0 if the option was recognized.
try_parse_remote_db_option() {
  CONSUMED=0
  case "$1" in
    --host)
      if [ -z "${2:-}" ]; then
        echo "Error: --host requires a hostname"
        exit 1
      fi
      DB_ADMIN_HOST="$2"
      CONSUMED=2
      return 0
      ;;
    --port)
      if [ -z "${2:-}" ] || ! [[ "$2" =~ ^[0-9]+$ ]]; then
        echo "Error: --port requires a numeric port"
        exit 1
      fi
      DB_ADMIN_PORT="$2"
      CONSUMED=2
      return 0
      ;;
    --admin-user)
      if [ -z "${2:-}" ]; then
        echo "Error: --admin-user requires a username"
        exit 1
      fi
      DB_ADMIN_USER="$2"
      CONSUMED=2
      return 0
      ;;
    --admin-password)
      if [ $# -ge 2 ]; then
        DB_ADMIN_PASSWORD="$2"
        CONSUMED=2
      else
        DB_ADMIN_PASSWORD=""
        CONSUMED=1
      fi
      DB_ADMIN_PASSWORD_PROVIDED=1
      return 0
      ;;
    --user-host)
      if [ -z "${2:-}" ]; then
        echo "Error: --user-host requires a MySQL user host"
        exit 1
      fi
      if ! [[ "$2" =~ ^[a-zA-Z0-9._:%-]+$ ]]; then
        echo "Error: invalid --user-host '$2'"
        exit 1
      fi
      MYSQL_USER_HOST="$2"
      CONSUMED=2
      return 0
      ;;
  esac
  return 1
}

require_db_name_for_remote_opts() {
  if [ -n "${DB_ADMIN_HOST:-}" ] || [ -n "${DB_ADMIN_PORT:-}" ] || [ -n "${DB_ADMIN_USER:-}" ] \
    || [ "${DB_ADMIN_PASSWORD_PROVIDED:-0}" = "1" ] || [ -n "${MYSQL_USER_HOST:-}" ]; then
    echo "Error: --host / --port / --admin-user / --admin-password / --user-host require -d <db_name>"
    exit 1
  fi
}

resolve_remote_db_opts() {
  if [ -n "${MYSQL_USER_HOST:-}" ] && [ "${SELECTED_DB_TYPE}" = "pgsql" ]; then
    echo "Error: --user-host is only valid for MySQL."
    exit 1
  fi

  if ! db_admin_is_remote; then
    if [ -z "${MYSQL_USER_HOST:-}" ]; then
      MYSQL_USER_HOST=localhost
    fi
    return 0
  fi

  if [ -z "${DB_ADMIN_PORT:-}" ]; then
    DB_ADMIN_PORT="$(db_default_port)"
  fi

  if [ -z "${DB_ADMIN_USER:-}" ]; then
    if [ "$SELECTED_DB_TYPE" = "mysql" ]; then
      DB_ADMIN_USER=root
    else
      DB_ADMIN_USER=postgres
    fi
  fi

  if [ "${DB_ADMIN_PASSWORD_PROVIDED:-0}" != "1" ]; then
    if [ ! -t 0 ]; then
      echo "Error: --admin-password is required when stdin is not a terminal."
      exit 1
    fi
    read -r -s -p "Enter password: " DB_ADMIN_PASSWORD
    echo
    DB_ADMIN_PASSWORD_PROVIDED=1
  fi

  if [ -z "${MYSQL_USER_HOST:-}" ]; then
    case "$DB_ADMIN_HOST" in
      localhost|127.0.0.1)
        MYSQL_USER_HOST=localhost
        ;;
      *)
        MYSQL_USER_HOST='%'
        ;;
    esac
  fi
}

app_db_host() {
  if db_admin_is_remote; then
    printf '%s\n' "$DB_ADMIN_HOST"
  else
    printf '%s\n' 127.0.0.1
  fi
}

app_db_port() {
  if [ -n "${DB_ADMIN_PORT:-}" ]; then
    printf '%s\n' "$DB_ADMIN_PORT"
  else
    db_default_port
  fi
}

validate_db_name() {
  local db_name="$1"

  if ! [[ "$db_name" =~ ^[a-zA-Z_][a-zA-Z0-9_-]*$ ]]; then
    echo "Error: database name may only contain letters, numbers, underscores and hyphens, and must start with a letter or underscore."
    exit 1
  fi

  if [ "${#db_name}" -gt 63 ]; then
    echo "Error: database name must be at most 63 characters."
    exit 1
  fi
}

random_db_password() {
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -hex 16
  else
    dd if=/dev/urandom bs=16 count=1 2>/dev/null | od -An -tx1 | tr -d ' \n'
  fi
}

postgres_admin() {
  if db_admin_is_remote; then
    if ! postgres_client_available; then
      echo "Error: psql is not installed. Run: server-tool install postgresql"
      exit 1
    fi
    PGPASSWORD="${DB_ADMIN_PASSWORD}" psql \
      --host="$DB_ADMIN_HOST" \
      --port="${DB_ADMIN_PORT:-5432}" \
      --username="${DB_ADMIN_USER:-postgres}" \
      --dbname=postgres \
      "$@"
  else
    if ! command -v psql >/dev/null 2>&1 || ! id postgres &>/dev/null; then
      echo "Error: PostgreSQL is not installed. Run: server-tool install postgresql"
      exit 1
    fi
    sudo -u postgres psql "$@"
  fi
}

create_postgres_database() {
  local db_name="$1"
  CREATED_DB_PASSWORD=""
  CREATED_DB_IS_NEW=0

  case "$db_name" in
    postgres|template0|template1|template_postgres|root|admin|replicator|public)
      echo "Error: refusing to create database '$db_name'"
      exit 1
      ;;
  esac

  validate_db_name "$db_name"

  if db_admin_is_remote; then
    if ! postgres_client_available; then
      echo "Error: psql is not installed. Run: server-tool install postgresql"
      exit 1
    fi
  else
    if ! command -v psql >/dev/null 2>&1 || ! id postgres &>/dev/null; then
      echo "Error: PostgreSQL is not installed. Run: server-tool install postgresql"
      exit 1
    fi

    if ! systemctl is-active --quiet postgresql; then
      echo "Error: PostgreSQL is not running."
      exit 1
    fi
  fi

  if ! postgres_admin -v ON_ERROR_STOP=1 -c "SELECT 1" >/dev/null; then
    echo "Error: could not connect to PostgreSQL as admin."
    exit 1
  fi

  local role_exists=0
  local db_exists=0
  if postgres_admin -tAc "SELECT 1 FROM pg_roles WHERE rolname = '$db_name'" | grep -qx 1; then
    role_exists=1
  fi
  if postgres_admin -tAc "SELECT 1 FROM pg_database WHERE datname = '$db_name'" | grep -qx 1; then
    db_exists=1
  fi

  if [ "$role_exists" -eq 1 ] || [ "$db_exists" -eq 1 ]; then
    if [ "$role_exists" -eq 1 ]; then
      echo "PostgreSQL user '$db_name' already exists, leaving password unchanged."
    fi
    if [ "$db_exists" -eq 1 ]; then
      echo "PostgreSQL database '$db_name' already exists, leaving it unchanged."
    fi
    return 0
  fi

  local password
  password="$(random_db_password)"

  postgres_admin -v ON_ERROR_STOP=1 -c "CREATE USER \"${db_name}\" WITH PASSWORD '${password}';"
  postgres_admin -v ON_ERROR_STOP=1 -c "CREATE DATABASE \"${db_name}\" OWNER \"${db_name}\";"

  CREATED_DB_PASSWORD="$password"
  CREATED_DB_IS_NEW=1
}

mysql_cli_bin() {
  if command -v mysql >/dev/null 2>&1; then
    printf '%s\n' mysql
    return 0
  fi
  if command -v mariadb >/dev/null 2>&1; then
    printf '%s\n' mariadb
    return 0
  fi
  return 1
}

mysql_dump_bin() {
  if command -v mysqldump >/dev/null 2>&1; then
    printf '%s\n' mysqldump
    return 0
  fi
  if command -v mariadb-dump >/dev/null 2>&1; then
    printf '%s\n' mariadb-dump
    return 0
  fi
  return 1
}

mysql_write_client_cnf() {
  local dest="$1"
  local host="$2"
  local port="$3"
  local user="$4"
  local password="$5"
  local escaped="$password"
  escaped="${escaped//\\/\\\\}"
  escaped="${escaped//\"/\\\"}"
  cat > "$dest" <<EOF
[client]
host=${host}
port=${port}
user=${user}
password="${escaped}"
protocol=TCP
EOF
}

mysql_write_admin_cnf() {
  mysql_write_client_cnf "$1" "$DB_ADMIN_HOST" "${DB_ADMIN_PORT:-3306}" "${DB_ADMIN_USER:-root}" "$DB_ADMIN_PASSWORD"
}

mysql_with_app_cnf() {
  local bin="$1"
  shift
  local tmpcnf rc=0
  tmpcnf="$(mktemp)"
  chmod 600 "$tmpcnf"
  mysql_write_client_cnf "$tmpcnf" "$DB_HOST" "${DB_PORT:-3306}" "$DB_USERNAME" "$DB_PASSWORD"
  "$bin" --defaults-file="$tmpcnf" "$@" || rc=$?
  rm -f "$tmpcnf"
  return "$rc"
}

mysql_admin() {
  local bin tmpcnf rc=0
  bin="$(mysql_cli_bin)" || {
    echo "Error: MySQL/MariaDB client is not installed. Run: server-tool install mysql-client or server-tool install mariadb-client"
    exit 1
  }
  if db_admin_is_remote; then
    tmpcnf="$(mktemp)"
    chmod 600 "$tmpcnf"
    mysql_write_admin_cnf "$tmpcnf"
    "$bin" --defaults-file="$tmpcnf" "$@" || rc=$?
    rm -f "$tmpcnf"
    return "$rc"
  fi
  "$bin" "$@"
}

create_mysql_database() {
  local db_name="$1"
  local user_host="${MYSQL_USER_HOST:-localhost}"
  CREATED_DB_PASSWORD=""
  CREATED_DB_IS_NEW=0

  case "$db_name" in
    mysql|information_schema|performance_schema|sys|root|admin)
      echo "Error: refusing to create database '$db_name'"
      exit 1
      ;;
  esac

  validate_db_name "$db_name"

  if db_admin_is_remote; then
    if ! mysql_client_available; then
      echo "Error: MySQL/MariaDB client is not installed. Run: server-tool install mysql-client or server-tool install mariadb-client"
      exit 1
    fi
  elif ! mysql_available; then
    echo "Error: MySQL/MariaDB is not installed or not running. Run: server-tool install mysql or server-tool install mariadb-server"
    exit 1
  fi

  if db_admin_is_remote; then
    echo "Connecting to MySQL at ${DB_ADMIN_HOST}:${DB_ADMIN_PORT:-3306} as ${DB_ADMIN_USER}..."
  fi
  if ! mysql_admin -e "SELECT 1" >/dev/null; then
    if db_admin_is_remote; then
      echo "Error: could not connect to MySQL admin ${DB_ADMIN_USER} at ${DB_ADMIN_HOST}:${DB_ADMIN_PORT:-3306}."
      echo "MySQL messages like user@'x.x.x.x' show this server's client address, not --host."
    else
      echo "Error: could not connect to MySQL as admin."
    fi
    exit 1
  fi

  local role_exists=0
  local db_exists=0
  if mysql_admin -N -B -e "SELECT 1 FROM mysql.user WHERE user = '${db_name}' AND host = '${user_host}'" | grep -qx 1; then
    role_exists=1
  fi
  if mysql_admin -N -B -e "SELECT 1 FROM information_schema.schemata WHERE schema_name = '${db_name}'" | grep -qx 1; then
    db_exists=1
  fi

  if [ "$role_exists" -eq 1 ] || [ "$db_exists" -eq 1 ]; then
    if [ "$role_exists" -eq 1 ]; then
      echo "MySQL user '$db_name'@'$user_host' already exists, leaving password unchanged."
    fi
    if [ "$db_exists" -eq 1 ]; then
      echo "MySQL database '$db_name' already exists, leaving it unchanged."
    fi
    return 0
  fi

  local password
  password="$(random_db_password)"

  mysql_admin -e "CREATE USER '${db_name}'@'${user_host}' IDENTIFIED BY '${password}';"
  mysql_admin -e "CREATE DATABASE \`${db_name}\`;"
  mysql_admin -e "GRANT ALL PRIVILEGES ON \`${db_name}\`.* TO '${db_name}'@'${user_host}';"

  CREATED_DB_PASSWORD="$password"
  CREATED_DB_IS_NEW=1
}

create_database() {
