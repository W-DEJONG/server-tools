#!/bin/bash

require_supported_debian() {
  if [ ! -f /etc/os-release ]; then
    echo "Error: cannot determine OS. This tool requires Debian 12 (bookworm) or Debian 13 (trixie)."
    exit 1
  fi

  # shellcheck disable=SC1091
  . /etc/os-release

  if [ "${ID:-}" != "debian" ]; then
    echo "Error: this tool only supports Debian. Detected: ${ID:-unknown}."
    exit 1
  fi

  case "${VERSION_CODENAME:-}" in
    bookworm|trixie)
      ;;
    *)
      echo "Error: Debian ${VERSION_CODENAME:-unknown} is not supported."
      echo "Supported releases: Debian 12 (bookworm) and Debian 13 (trixie)."
      exit 1
      ;;
  esac
}

debian_codename() {
  # shellcheck disable=SC1091
  . /etc/os-release
  printf '%s\n' "$VERSION_CODENAME"
}

debian_arch() {
  dpkg --print-architecture
}

confirm_or_exit() {
  local message="$1"
  if [ "${ASSUME_YES:-0}" = "1" ]; then
    return 0
  fi

  local confirm
  read -r -p "$message" confirm
  if [ "$confirm" != "y" ]; then
    echo "Script execution aborted."
    exit 0
  fi
}

ensure_login_bashrc() {
  local bashrc="$1"
  local with_become="${2:-0}"
  local bashrc_dir

  bashrc_dir="$(dirname "$bashrc")"
  if [ ! -d "$bashrc_dir" ]; then
    return 0
  fi

  touch "$bashrc"

  if ! grep -qxF "export LS_OPTIONS='--color=auto'" "$bashrc"; then
    cat >> "$bashrc" <<'EOF'
export LS_OPTIONS='--color=auto'
eval "$(dircolors)"
alias ls='ls $LS_OPTIONS'
alias ll='ls $LS_OPTIONS -l'
alias l='ls $LS_OPTIONS -lA'
EOF
  fi

  if [ "$with_become" = "1" ] && ! grep -qxF "alias become='sudo su -l'" "$bashrc"; then
    echo "alias become='sudo su -l'" >> "$bashrc"
  fi
}

require_application() {
  local username="$1"
  local app_name="$2"

  case "$username" in
    ""|*/*|root|admin|www-data|nginx|nobody|daemon)
      echo "Error: refusing to change an application for user '$username'"
      exit 1
      ;;
  esac

  case "$app_name" in
    ""|*/*|.|..|.ssh)
      echo "Error: invalid application name '$app_name'"
      exit 1
      ;;
  esac

  if ! id "$username" &>/dev/null; then
    echo "Error: user '$username' not found."
    exit 1
  fi

  APP_ROOT="/home/${username}/${app_name}"
  APP_NGINX_CONF="${APP_ROOT}/nginx/${app_name}.conf"

  if [ ! -d "$APP_ROOT" ] || [ ! -f "$APP_NGINX_CONF" ]; then
    echo "Error: application '$app_name' for user '$username' not found."
    exit 1
  fi
}

app_php_version_from_nginx() {
  local conf="$1"
  sed -n 's|.*unix:/run/php/php\([0-9][0-9.]*\)-fpm-.*|\1|p' "$conf" | head -1
}

app_server_name_from_nginx() {
  local conf="$1"
  sed -n 's/^[[:space:]]*server_name[[:space:]]*\([^;[:space:]]*\).*/\1/p' "$conf" | head -1
}

render_nginx_app_conf() {
  local template="$1"
  local dest="$2"
  local username="$3"
  local app_name="$4"
  local app_root="$5"
  local php_version="$6"
  local server_name="$7"
  local ssl_cert="${8:-}"
  local ssl_key="${9:-}"

  sed -e "s|{{USERNAME}}|$username|g" \
      -e "s|{{APP_NAME}}|$app_name|g" \
      -e "s|{{APP_ROOT}}|$app_root|g" \
      -e "s|{{PHP_VERSION}}|$php_version|g" \
      -e "s|{{SERVER_NAME}}|$server_name|g" \
      -e "s|{{SSL_CERT}}|$ssl_cert|g" \
      -e "s|{{SSL_KEY}}|$ssl_key|g" \
      "$template" > "$dest"
}

reload_nginx() {
  nginx -t
  nginx -s reload
}

read_versions_from_file() {
  local file="$1"
  local line
  ALLOWED_VERSIONS=()

  while IFS= read -r line; do
    [ -n "$line" ] || continue
    ALLOWED_VERSIONS+=("$line")
  done < "$file"

  if [ ${#ALLOWED_VERSIONS[@]} -eq 0 ]; then
    echo "Error: no versions found in $file"
    exit 1
  fi
}

version_is_allowed() {
  local candidate="$1"
  local allowed
  for allowed in "${ALLOWED_VERSIONS[@]}"; do
    if [ "$candidate" = "$allowed" ]; then
      return 0
    fi
  done
  return 1
}

select_version_from_file() {
  local prompt="$1"
  local file="$2"

  read_versions_from_file "$file"

  PS3="$prompt"
  select version in "${ALLOWED_VERSIONS[@]}"; do
    if [ -n "$version" ]; then
      SELECTED_VERSION="$version"
      return 0
    fi
    echo "Invalid selection."
  done
}

# resolve_versions <versions-file> <prompt> <allow_multiple 0|1> [version ...]
resolve_versions() {
  local file="$1"
  local prompt="$2"
  local allow_multiple="$3"
  shift 3

  read_versions_from_file "$file"
  SELECTED_VERSIONS=()

  if [ $# -gt 0 ]; then
    local requested
    for requested in "$@"; do
      if ! version_is_allowed "$requested"; then
        echo "Error: unsupported version '$requested'."
        echo "Available versions: ${ALLOWED_VERSIONS[*]}"
        exit 1
      fi
      SELECTED_VERSIONS+=("$requested")
    done
  else
    select_version_from_file "$prompt" "$file"
    SELECTED_VERSIONS=("$SELECTED_VERSION")
  fi

  if [ "$allow_multiple" != "1" ] && [ ${#SELECTED_VERSIONS[@]} -gt 1 ]; then
    echo "Error: this package accepts only one version."
    echo "Available versions: ${ALLOWED_VERSIONS[*]}"
    exit 1
  fi

  SELECTED_VERSION="${SELECTED_VERSIONS[0]}"
}

create_postgres_database() {
  local db_name="$1"
  CREATED_DB_PASSWORD=""
  CREATED_DB_IS_NEW=0

  case "$db_name" in
    postgres|template0|template1|template_postgres|root|admin|replicator|public)
      echo "Error: refusing to create database '$db_name'"
      exit 1
      ;;
  esac

  if ! [[ "$db_name" =~ ^[a-zA-Z_][a-zA-Z0-9_-]*$ ]]; then
    echo "Error: database name may only contain letters, numbers, underscores and hyphens, and must start with a letter or underscore."
    exit 1
  fi

  if [ "${#db_name}" -gt 63 ]; then
    echo "Error: database name must be at most 63 characters."
    exit 1
  fi

  if ! command -v psql >/dev/null 2>&1 || ! id postgres &>/dev/null; then
    echo "Error: PostgreSQL is not installed. Run: server-tool install postgresql"
    exit 1
  fi

  if ! systemctl is-active --quiet postgresql; then
    echo "Error: PostgreSQL is not running."
    exit 1
  fi

  local role_exists=0
  local db_exists=0
  if sudo -u postgres psql -tAc "SELECT 1 FROM pg_roles WHERE rolname = '$db_name'" | grep -qx 1; then
    role_exists=1
  fi
  if sudo -u postgres psql -tAc "SELECT 1 FROM pg_database WHERE datname = '$db_name'" | grep -qx 1; then
    db_exists=1
  fi

  if [ "$role_exists" -eq 1 ] || [ "$db_exists" -eq 1 ]; then
    if [ "$role_exists" -eq 1 ]; then
      echo "PostgreSQL user '$db_name' already exists, leaving password unchanged."
    fi
    if [ "$db_exists" -eq 1 ]; then
      echo "PostgreSQL database '$db_name' already exists, leaving it unchanged."
    fi
    return 0
  fi

  local password
  if command -v openssl >/dev/null 2>&1; then
    password="$(openssl rand -hex 16)"
  else
    password="$(dd if=/dev/urandom bs=16 count=1 2>/dev/null | od -An -tx1 | tr -d ' \n')"
  fi

  sudo -u postgres psql -v ON_ERROR_STOP=1 -c "CREATE USER \"${db_name}\" WITH PASSWORD '${password}';"
  sudo -u postgres psql -v ON_ERROR_STOP=1 -c "CREATE DATABASE \"${db_name}\" OWNER \"${db_name}\";"

  CREATED_DB_PASSWORD="$password"
  CREATED_DB_IS_NEW=1
}

apply_app_nginx_acl() {
  local username="$1"
  local app_root="$2"
  local user_home="/home/${username}"
  local releases="${app_root}/releases"
  local nginx_user="nginx"

  if ! command -v setfacl >/dev/null 2>&1; then
    echo "Installing acl for nginx folder permissions..."
    apt-get -y install acl
  fi

  if ! id "$nginx_user" &>/dev/null; then
    echo "Error: nginx user not found. Run: server-tool install nginx"
    exit 1
  fi

  if [ ! -d "$user_home" ]; then
    echo "Error: home directory does not exist: $user_home"
    exit 1
  fi

  if [ ! -d "$app_root" ]; then
    echo "Error: application directory does not exist: $app_root"
    exit 1
  fi

  mkdir -p "$releases"
  chown "$username:$username" "$releases"

  echo "Setting ACL permissions for $app_root"
  setfacl -m "u:${nginx_user}:--x" "$user_home"
  setfacl -m "u:${nginx_user}:--x" "$app_root"
  setfacl -R -m "u:${nginx_user}:rX" "$releases"
  setfacl -R -m "d:u:${nginx_user}:rX" "$releases"

  if [ -d "$app_root/install" ]; then
    setfacl -R -m "u:${nginx_user}:rX" "$app_root/install"
    setfacl -R -m "d:u:${nginx_user}:rX" "$app_root/install"
  fi

  if [ -d "$app_root/current" ] && [ ! -L "$app_root/current" ]; then
    setfacl -R -m "u:${nginx_user}:rX" "$app_root/current"
    setfacl -R -m "d:u:${nginx_user}:rX" "$app_root/current"
  fi

  if [ -d "$app_root/log" ]; then
    setfacl -R -m "u:${nginx_user}:rwX" "$app_root/log"
    setfacl -R -m "d:u:${nginx_user}:rwX" "$app_root/log"
  fi

  local current_index="${app_root}/current/public/index.php"
  if [ -e "$current_index" ]; then
    if sudo -u "$nginx_user" test -r "$current_index"; then
      echo "OK: ${nginx_user} can read ${current_index}"
    else
      echo "Error: ${nginx_user} cannot read ${current_index}"
      exit 1
    fi
  fi
}

php_fpm_is_installed() {
  local version="$1"
  command -v "php-fpm${version}" >/dev/null 2>&1 && [ -d "/etc/php/${version}/fpm/pool.d" ]
}

ensure_app_supervisor() {
  local username="$1"
  local app_name="$2"
  local app_root="${3:-/home/${username}/${app_name}}"

  ensure_supervisor_app_includes
  mkdir -p "$app_root/supervisor"
  chown "$username:$username" "$app_root/supervisor"
  mkdir -p /etc/supervisor/conf.d
  ln -sfn "$app_root/supervisor" "/etc/supervisor/conf.d/${username}_${app_name}.d"
}

ensure_supervisor_app_includes() {
  if [ ! -f /etc/supervisor/supervisord.conf ]; then
    apt-get -y install supervisor
  fi

  local conf="/etc/supervisor/supervisord.conf"
  local wanted='files = /etc/supervisor/conf.d/*.conf /etc/supervisor/conf.d/*.d/*.conf'

  if grep -qF "$wanted" "$conf"; then
    return 0
  fi

  if grep -qE '^[[:space:]]*files[[:space:]]*=' "$conf"; then
    sed -i 's|^[[:space:]]*files[[:space:]]*=.*|'"$wanted"'|' "$conf"
  else
    printf '\n[include]\n%s\n' "$wanted" >> "$conf"
  fi
}

reload_supervisor() {
  if ! command -v supervisorctl >/dev/null 2>&1; then
    return 0
  fi
  if systemctl is-active --quiet supervisor || systemctl is-active --quiet supervisord; then
    supervisorctl reread
    supervisorctl update
  fi
}

ensure_php_fpm() {
  local version="$1"
  if php_fpm_is_installed "$version"; then
    return 0
  fi

  echo "PHP ${version} FPM is not installed. Installing..."
  "$SERVER_TOOL_ROOT/server-tool" install php -y "$version"
}

ensure_sury_php_repo() {
  apt-get update
  apt-get -y install lsb-release ca-certificates curl
  curl -sSLo /tmp/debsuryorg-archive-keyring.deb https://packages.sury.org/debsuryorg-archive-keyring.deb
  dpkg -i /tmp/debsuryorg-archive-keyring.deb
  rm -f /tmp/debsuryorg-archive-keyring.deb
  echo "deb [signed-by=/usr/share/keyrings/debsuryorg-archive-keyring.gpg] https://packages.sury.org/php/ $(debian_codename) main" > /etc/apt/sources.list.d/php.list
  # Replace the previous trusted.gpg.d key drop used on older installs
  rm -f /etc/apt/trusted.gpg.d/php.gpg
  apt-get update
}

ensure_nodesource_repo() {
  local node_major="$1"
  local arch

  arch="$(debian_arch)"
  if [ "$arch" != "amd64" ] && [ "$arch" != "arm64" ]; then
    echo "Error: NodeSource only supports amd64 and arm64. Detected: $arch"
    exit 1
  fi

  apt-get -y install ca-certificates curl gnupg
  mkdir -p /usr/share/keyrings
  curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor | tee /usr/share/keyrings/nodesource.gpg >/dev/null
  chmod 644 /usr/share/keyrings/nodesource.gpg

  cat > /etc/apt/sources.list.d/nodesource.sources <<EOF
Types: deb
URIs: https://deb.nodesource.com/node_${node_major}.x
Suites: nodistro
Components: main
Architectures: ${arch}
Signed-By: /usr/share/keyrings/nodesource.gpg
EOF

  cat > /etc/apt/preferences.d/nodejs <<EOF
Package: nodejs
Pin: origin deb.nodesource.com
Pin-Priority: 600
EOF

  apt-get update
}

ensure_pgdg_repo() {
  local arch

  arch="$(debian_arch)"
  apt-get -y install curl ca-certificates
  install -d /usr/share/postgresql-common/pgdg
  curl -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc --fail https://www.postgresql.org/media/keys/ACCC4CF8.asc

  cat > /etc/apt/sources.list.d/pgdg.sources <<EOF
Types: deb
URIs: https://apt.postgresql.org/pub/repos/apt
Suites: $(debian_codename)-pgdg
Architectures: ${arch}
Components: main
Signed-By: /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc
EOF

  apt-get update
}

ensure_redis_repo() {
  apt-get -y install lsb-release curl gpg
  mkdir -p /usr/share/keyrings
  curl -fsSL https://packages.redis.io/gpg | gpg --dearmor | tee /usr/share/keyrings/redis-archive-keyring.gpg >/dev/null
  chmod 644 /usr/share/keyrings/redis-archive-keyring.gpg
  echo "deb [signed-by=/usr/share/keyrings/redis-archive-keyring.gpg] https://packages.redis.io/deb $(debian_codename) main" > /etc/apt/sources.list.d/redis.list
  if ! apt-get update; then
    echo "Official Redis repo is not available for $(debian_codename); falling back to Debian packages."
    rm -f /etc/apt/sources.list.d/redis.list
    apt-get update
  fi
}

ensure_mariadb_repo() {
  apt-get -y install curl ca-certificates
  curl -LsS https://r.mariadb.com/downloads/mariadb_repo_setup | bash -s -- --mariadb-server-version=mariadb-11.8 --skip-maxscale --skip-tools
}

ensure_meilisearch_repo() {
  apt-get -y install ca-certificates
  echo "deb [trusted=yes] https://apt.fury.io/meilisearch/ /" > /etc/apt/sources.list.d/meilisearch.list
  apt-get update
}

ensure_nginx_repo() {
  apt-get -y install curl gnupg2 ca-certificates lsb-release debian-archive-keyring
  mkdir -p /usr/share/keyrings
  curl -fsSL https://nginx.org/keys/nginx_signing.key | gpg --dearmor | tee /usr/share/keyrings/nginx-archive-keyring.gpg >/dev/null
  echo "deb [signed-by=/usr/share/keyrings/nginx-archive-keyring.gpg] https://nginx.org/packages/debian $(debian_codename) nginx" > /etc/apt/sources.list.d/nginx.list
  printf 'Package: *\nPin: origin nginx.org\nPin: release o=nginx\nPin-Priority: 900\n' > /etc/apt/preferences.d/99nginx
  apt-get update
}
