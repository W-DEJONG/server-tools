#!/bin/bash
set -eo pipefail

# shellcheck disable=SC1091
source "$SERVER_TOOL_ROOT/lib/common"

confirm_or_exit "This will install and configure cachetool. Do you want to proceed? (y/n): "

echo "Installing cachetool..."
curl -sL -o /usr/local/bin/cachetool https://github.com/gordalina/cachetool/releases/latest/download/cachetool.phar
chmod +x /usr/local/bin/cachetool
