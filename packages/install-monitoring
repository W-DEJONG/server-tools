#!/bin/bash
set -eo pipefail

# shellcheck disable=SC1091
source "$SERVER_TOOL_ROOT/lib/common"

domain=""
email=""
usage="Usage: server-tool install monitoring -d <domain> -e <email> [-y]"
config_file="/etc/server-tool/monitoring.conf"
api_key_file="/etc/server-tool/monitoring-api.key"
map_file="/etc/server-tool/nginx-monitoring-map.conf"

while [ $# -gt 0 ]; do
  case "$1" in
    -d|--domain)
      if [ -z "${2:-}" ]; then
        echo "Error: -d requires a domain"
        echo "$usage"
        exit 1
      fi
      domain="$2"
      shift 2
      ;;
    -e|--email)
      if [ -z "${2:-}" ]; then
        echo "Error: -e requires an email address"
        echo "$usage"
        exit 1
      fi
      email="$2"
      shift 2
      ;;
    *)
      echo "Error: unknown argument '$1'"
      echo "$usage"
      exit 1
      ;;
  esac
done

if [ -z "$domain" ] || [ -z "$email" ]; then
  echo "$usage"
  exit 1
fi

require_valid_domain "$domain"
if [[ "$domain" != *.* ]]; then
  echo "Error: domain '$domain' must contain a dot."
  exit 1
fi
if ! [[ "$email" =~ ^[^[:space:]@]+@[^[:space:]@]+$ ]]; then
  echo "Error: invalid email '$email'"
  exit 1
fi

confirm_or_exit "This will install Prometheus, Loki and Grafana for ${domain}. Do you want to proceed? (y/n): "

echo "Installing Prometheus, Loki and Grafana..."
ensure_grafana_repo

install_nginx=0
if ! command -v nginx >/dev/null 2>&1; then
  ensure_nginx_repo
  install_nginx=1
fi

packages=(prometheus loki grafana certbot python3-certbot-nginx)
if [ "$install_nginx" -eq 1 ]; then
  packages+=(nginx ufw)
fi
apt_get install -y "${packages[@]}"

if [ "$install_nginx" -eq 1 ]; then
  systemctl enable nginx
  systemctl start nginx
  ufw allow 80/tcp
  ufw allow 443/tcp
fi

api_key=""
grafana_password=""
if [ -f "$config_file" ]; then
  # shellcheck disable=SC1090
  source "$config_file"
  api_key="${MONITORING_API_KEY:-}"
  grafana_password="${GRAFANA_ADMIN_PASSWORD:-}"
fi
if [ -z "$api_key" ]; then
  api_key="$(openssl rand -hex 32)"
fi
if [ -z "$grafana_password" ]; then
  grafana_password="$(openssl rand -hex 24)"
fi

install -d -m 755 /etc/server-tool
cat > "$config_file" <<EOF
MONITORING_DOMAIN=${domain}
MONITORING_API_KEY=${api_key}
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=${grafana_password}
PROMETHEUS_REMOTE_WRITE_URL=https://${domain}/api/v1/write
LOKI_PUSH_URL=https://${domain}/loki/api/v1/push
EOF
chmod 600 "$config_file"
printf '%s\n' "$api_key" > "$api_key_file"
chmod 600 "$api_key_file"

prom_bin="$(command -v prometheus)"
prom_args=(
  "$prom_bin"
  --config.file=/etc/prometheus/prometheus.yml
  --storage.tsdb.path=/var/lib/prometheus
  --web.listen-address=127.0.0.1:9090
  --web.enable-remote-write-receiver
  --web.enable-lifecycle
)
if [ -d /etc/prometheus/consoles ]; then
  prom_args+=(--web.console.templates=/etc/prometheus/consoles)
fi
if [ -d /etc/prometheus/console_libraries ]; then
  prom_args+=(--web.console.libraries=/etc/prometheus/console_libraries)
fi
install -d /etc/systemd/system/prometheus.service.d
cat > /etc/systemd/system/prometheus.service.d/server-tool.conf <<EOF
[Service]
ExecStart=
ExecStart=${prom_args[*]}
EOF

install -d -m 755 /etc/loki /var/lib/loki
install -m 644 "$SERVER_TOOL_ROOT/templates/loki/server-tool.yaml" /etc/loki/server-tool.yaml
chown -R loki /var/lib/loki
loki_bin="$(command -v loki)"
install -d /etc/systemd/system/loki.service.d
cat > /etc/systemd/system/loki.service.d/server-tool.conf <<EOF
[Service]
ExecStart=
ExecStart=${loki_bin} -config.file=/etc/loki/server-tool.yaml
EOF
loki -config.file=/etc/loki/server-tool.yaml -verify-config

mkdir -p /etc/grafana/provisioning/datasources
install -m 644 -o root -g grafana "$SERVER_TOOL_ROOT/templates/grafana/datasources.yaml" /etc/grafana/provisioning/datasources/server-tool.yaml
install_grafana_dashboards

install -d /etc/systemd/system/grafana-server.service.d
cat > /etc/systemd/system/grafana-server.service.d/server-tool.conf <<EOF
[Service]
Environment=GF_SERVER_HTTP_ADDR=127.0.0.1
Environment=GF_SERVER_HTTP_PORT=3000
Environment=GF_SERVER_DOMAIN=${domain}
Environment=GF_SERVER_ROOT_URL=https://${domain}/
Environment=GF_AUTH_ANONYMOUS_ENABLED=false
Environment=GF_USERS_ALLOW_SIGN_UP=false
Environment=GF_SECURITY_ADMIN_USER=admin
Environment=GF_SECURITY_ADMIN_PASSWORD=${grafana_password}
Environment=GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH=/var/lib/grafana/dashboards/server-tools/server.json
EOF
chmod 600 /etc/systemd/system/grafana-server.service.d/server-tool.conf

install -d /etc/nginx/sites-available /etc/nginx/sites-enabled
if ! grep -RqsE 'include[[:space:]]+/etc/nginx/sites-enabled/\*;' /etc/nginx/nginx.conf /etc/nginx/conf.d 2>/dev/null; then
  echo 'include /etc/nginx/sites-enabled/*;' > /etc/nginx/conf.d/00-server-tool-sites.conf
fi
cat > "$map_file" <<EOF
map \$http_x_api_key \$server_tool_monitoring_api_key_ok {
    default 0;
    "${api_key}" 1;
}
EOF
chmod 600 "$map_file"
cat > /etc/nginx/conf.d/00-server-tool-monitoring-map.conf <<EOF
map_hash_bucket_size 128;
include ${map_file};
EOF

cat > /etc/nginx/sites-available/monitoring <<EOF
server {
    listen 80;
    listen [::]:80;
    server_name ${domain};

    location /api/v1/write {
        if (\$server_tool_monitoring_api_key_ok = 0) {
            return 403;
        }

        proxy_pass http://127.0.0.1:9090/api/v1/write;
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_request_buffering off;
        client_max_body_size 32m;
    }

    location /loki/api/v1/push {
        if (\$server_tool_monitoring_api_key_ok = 0) {
            return 403;
        }

        proxy_pass http://127.0.0.1:3100/loki/api/v1/push;
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_request_buffering off;
        client_max_body_size 32m;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
EOF
ln -sfn /etc/nginx/sites-available/monitoring /etc/nginx/sites-enabled/monitoring
nginx -t

systemctl daemon-reload
systemctl enable --now prometheus
systemctl restart prometheus
systemctl enable --now loki
systemctl restart loki
systemctl enable --now grafana-server
systemctl restart grafana-server
if systemctl is-active --quiet nginx; then
  nginx -s reload
else
  systemctl enable --now nginx
fi

certbot --nginx -d "$domain" -m "$email" --agree-tos --non-interactive --redirect --keep-until-expiring
nginx -t
nginx -s reload

echo
echo "Monitoring is ready."
echo "  Grafana:  https://${domain}/"
echo "  Login:    admin"
echo "  Password: stored in ${config_file}"
echo "  API key:  ${api_key_file}"
echo
echo "On each application server, copy the API key file and run:"
echo "  server-tool install alloy --url https://${domain} --api-key-file ${api_key_file} -y"
