#!/bin/bash
set -eo pipefail

# shellcheck disable=SC1091
source "$SERVER_TOOL_ROOT/lib/common"

confirm_or_exit "This will install and configure nginx. Do you want to proceed? (y/n): "

echo "Installing nginx..."
ensure_nginx_repo
apt install -y nginx certbot python3-certbot-nginx
systemctl enable nginx
systemctl start nginx
