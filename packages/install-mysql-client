#!/bin/bash
set -eo pipefail

# shellcheck disable=SC1091
source "$SERVER_TOOL_ROOT/lib/common"

refuse_if_mariadb_installed
confirm_or_exit "This will install and configure MySQL client. Do you want to proceed? (y/n): "

echo "Installing MySQL client..."
ensure_mysql_repo
export DEBIAN_FRONTEND=noninteractive
apt install -y mysql-community-client
