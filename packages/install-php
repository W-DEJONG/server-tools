#!/bin/bash
set -eo pipefail

# shellcheck disable=SC1091
source "$SERVER_TOOL_ROOT/lib/common"

confirm_or_exit "This will install and configure PHP. Do you want to proceed? (y/n): "

ensure_sury_php_repo
resolve_versions "$SERVER_TOOL_ROOT/templates/php-versions" \
    'Which version of PHP needs to be installed? ' \
    1 \
    "$@"

for version in "${SELECTED_VERSIONS[@]}"; do
    echo "Installing PHP $version..."
    apt install -y \
        php${version}-cli \
        php${version}-fpm \
        php${version}-common \
        php${version}-gd \
        php${version}-intl \
        php${version}-curl \
        php${version}-mbstring \
        php${version}-mysql \
        php${version}-pgsql \
        php${version}-soap \
        php${version}-zip \
        php${version}-memcached \
        php${version}-redis \
        php${version}-xml \
        php${version}-gmp \
        php${version}-mongodb \
        php${version}-bcmath \
        php${version}-sqlite3 \
        php${version}-imagick

    cat > "/etc/php/${version}/fpm/conf.d/99-server-tool-large-files.ini" <<'EOF'
; Allow applications to stream files up to 100 GB through PHP-FPM.
upload_max_filesize = 150M
post_max_size = 151M
max_execution_time = 0
max_input_time = -1
EOF

    php-fpm${version} -tt
    systemctl restart "php${version}-fpm"
done
