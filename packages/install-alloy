#!/bin/bash
set -eo pipefail

# shellcheck disable=SC1091
source "$SERVER_TOOL_ROOT/lib/common"

url=""
api_key_file=""
usage="Usage: server-tool install alloy --url <https://host> --api-key-file <file> [-y]"

while [ $# -gt 0 ]; do
  case "$1" in
    --url)
      if [ -z "${2:-}" ]; then
        echo "Error: --url requires an https://host address"
        echo "$usage"
        exit 1
      fi
      url="$2"
      shift 2
      ;;
    --api-key-file)
      if [ -z "${2:-}" ]; then
        echo "Error: --api-key-file requires a file path"
        echo "$usage"
        exit 1
      fi
      api_key_file="$2"
      shift 2
      ;;
    *)
      echo "Error: unknown argument '$1'"
      echo "$usage"
      exit 1
      ;;
  esac
done

if [ -z "$url" ] || [ -z "$api_key_file" ]; then
  echo "$usage"
  exit 1
fi

url="${url%/}"
if ! [[ "$url" =~ ^https://[A-Za-z0-9.-]+(:[0-9]+)?$ ]]; then
  echo "Error: --url must be an https host without a path, such as https://grafana.example.com"
  echo "$usage"
  exit 1
fi

if [ ! -f "$api_key_file" ]; then
  echo "Error: API key file not found: $api_key_file"
  exit 1
fi

api_key="$(tr -d '[:space:]' < "$api_key_file")"
if [ -z "$api_key" ]; then
  echo "Error: API key file is empty: $api_key_file"
  exit 1
fi
if [[ "$api_key" == *[!A-Za-z0-9_-]* ]]; then
  echo "Error: API key may only contain letters, digits, hyphens and underscores."
  exit 1
fi

server_name="$(hostname -s)"
if ! [[ "$server_name" =~ ^[A-Za-z0-9._-]+$ ]]; then
  echo "Error: hostname '$server_name' cannot be used as a monitoring label."
  exit 1
fi

confirm_or_exit "This will install Grafana Alloy and send metrics and logs to ${url}. Do you want to proceed? (y/n): "

echo "Installing Grafana Alloy..."
ensure_grafana_repo
apt-get install -y alloy

if getent group systemd-journal >/dev/null; then
  usermod -a -G systemd-journal alloy
fi
if getent group adm >/dev/null; then
  usermod -a -G adm alloy
fi

install -d -m 755 /etc/alloy
sed \
  -e "s|__MONITORING_URL__|${url}|g" \
  -e "s|__API_KEY__|${api_key}|g" \
  -e "s|__SERVER_NAME__|${server_name}|g" \
  "$SERVER_TOOL_ROOT/templates/alloy/config.alloy" > /etc/alloy/config.alloy
chown root:alloy /etc/alloy/config.alloy
chmod 640 /etc/alloy/config.alloy

sync_all_app_monitoring

if alloy validate --help >/dev/null 2>&1; then
  alloy validate /etc/alloy/config.alloy
else
  alloy fmt /etc/alloy/config.alloy >/dev/null
fi

systemctl enable alloy
systemctl restart alloy

echo
echo "Grafana Alloy is sending metrics and logs to ${url}."
echo "  Config: /etc/alloy/config.alloy"
echo "  Probes: $(monitoring_blackbox_targets_file)"
