#!/bin/bash
set -eo pipefail

# shellcheck disable=SC1091
source "$SERVER_TOOL_ROOT/lib/common"

confirm_or_exit "This will install and configure redis. Do you want to proceed? (y/n): "

echo "Installing redis..."
ensure_redis_repo
apt install -y redis
systemctl enable --now redis-server 2>/dev/null || systemctl enable --now redis
