#!/bin/bash
set -eo pipefail

# shellcheck disable=SC1091
source "$SERVER_TOOL_ROOT/lib/common"

if [ $# -gt 1 ]; then
  echo "Error: at most one S3 bucket name is allowed."
  echo "Usage: server-tool install aws [<bucket>] [-y]"
  exit 1
fi

bucket="${1:-}"
bucket="${bucket#"${bucket%%[![:space:]]*}"}"
bucket="${bucket%"${bucket##*[![:space:]]}"}"

confirm_or_exit "This will install the AWS CLI. Do you want to proceed? (y/n): "

if [ -z "$bucket" ] && [ "${ASSUME_YES:-0}" != "1" ]; then
  read -r -p "S3 bucket for backups (leave empty to skip): " bucket
  bucket="${bucket#"${bucket%%[![:space:]]*}"}"
  bucket="${bucket%"${bucket##*[![:space:]]}"}"
fi

if [ -n "$bucket" ]; then
  validate_s3_bucket_name "$bucket"
fi

if command -v aws >/dev/null 2>&1; then
  echo "AWS CLI is already installed: $(command -v aws)"
else
  arch="$(debian_arch)"
  case "$arch" in
    amd64)
      cli_arch="x86_64"
      ;;
    arm64)
      cli_arch="aarch64"
      ;;
    *)
      echo "Error: AWS CLI is only packaged for amd64 and arm64. Detected: $arch"
      exit 1
      ;;
  esac

  apt-get -y install unzip curl

  tmpdir="$(mktemp -d -p /var/tmp)"
  cleanup_aws_install() {
    rm -rf "$tmpdir"
  }
  trap cleanup_aws_install EXIT

  echo "Installing AWS CLI"
  (
    cd "$tmpdir"
    curl "https://awscli.amazonaws.com/awscli-exe-linux-${cli_arch}.zip" -o "awscliv2.zip"
    unzip -q awscliv2.zip
    chmod +x ./aws/install
    ./aws/install -i /usr/local/aws-cli -b /usr/local/bin
  )
  trap - EXIT
  cleanup_aws_install
fi

if [ -n "$bucket" ]; then
  write_backup_config "$bucket"
  echo "Backup S3 bucket written to $BACKUP_CONFIG_FILE"
fi
