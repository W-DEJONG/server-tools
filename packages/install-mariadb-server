#!/bin/bash
set -eo pipefail

# shellcheck disable=SC1091
source "$SERVER_TOOL_ROOT/lib/common"

confirm_or_exit "This will install and configure MariaDB server. Do you want to proceed? (y/n): "

echo "Installing MariaDB server..."
ensure_mariadb_repo
apt install -y mariadb-server mariadb-backup
systemctl enable --now mariadb
