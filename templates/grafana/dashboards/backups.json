{
  "uid": "server-tools-backups",
  "title": "Backups",
  "description": "Backup results from /var/log/server-tool/backup.log. Successful and failed backups are both listed.",
  "tags": ["server-tools"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-7d", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "server",
        "label": "Server",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values({logtype=\"backup\"}, server)",
        "definition": "label_values({logtype=\"backup\"}, server)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "sort": 1
      },
      {
        "name": "username",
        "label": "User",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values({logtype=\"backup\"}, username)",
        "definition": "label_values({logtype=\"backup\"}, username)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "sort": 1
      },
      {
        "name": "application",
        "label": "Application",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values({logtype=\"backup\"}, application)",
        "definition": "label_values({logtype=\"backup\"}, application)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Failures in 24h",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({logtype=\"backup\", result=\"failed\", server=~\"$server\", username=~\"$username\", application=~\"$application\"}[24h]))",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": { "noValue": "0", "unit": "short" },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "logs",
      "title": "Backup results",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "{logtype=\"backup\", server=~\"$server\", username=~\"$username\", application=~\"$application\"}"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    }
  ]
}
