{
  "uid": "server-tools-http",
  "title": "HTTP status",
  "description": "Blackbox HTTP and HTTPS probes, and incoming request rates per server, application and domain.",
  "tags": ["server-tools"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "server",
        "label": "Server",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(probe_success, server)",
        "definition": "label_values(probe_success, server)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "sort": 1
      },
      {
        "name": "application",
        "label": "Application",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(loki_process_custom_nginx_requests_total{server=~\"$server\"}, application)",
        "definition": "label_values(loki_process_custom_nginx_requests_total{server=~\"$server\"}, application)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "sort": 1
      },
      {
        "name": "domain",
        "label": "Domain",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(loki_process_custom_nginx_requests_total{server=~\"$server\",application=~\"$application\"}, domain)",
        "definition": "label_values(loki_process_custom_nginx_requests_total{server=~\"$server\",application=~\"$application\"}, domain)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Probe success",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{server=~\"$server\",domain=~\".+\"}",
          "legendFormat": "{{domain}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "text": { "titleSize": 14, "valueSize": 28 }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Response time",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_duration_seconds{server=~\"$server\",domain=~\".+\"}",
          "legendFormat": "{{domain}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Status code",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_http_status_code{server=~\"$server\",domain=~\".+\"}",
          "legendFormat": "{{domain}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0 }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Requests per server",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 18 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (server) (rate(loki_process_custom_nginx_requests_total{server=~\"$server\",application=~\"$application\",domain=~\"$domain\",application!=\"\",domain!=\"\"}[5m]))",
          "legendFormat": "{{server}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "links": [
            {
              "title": "Applications",
              "url": "/d/server-tools-http?${__url_time_range}&var-server=${__field.labels.server}&var-application=All&var-domain=All",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Requests per application",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 18 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (server, application) (rate(loki_process_custom_nginx_requests_total{server=~\"$server\",application=~\"$application\",domain=~\"$domain\",application!=\"\",domain!=\"\"}[5m]))",
          "legendFormat": "{{application}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "links": [
            {
              "title": "Domains",
              "url": "/d/server-tools-http?${__url_time_range}&var-server=${__field.labels.server}&var-application=${__field.labels.application}&var-domain=All",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Requests per domain",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 18 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (server, application, domain) (rate(loki_process_custom_nginx_requests_total{server=~\"$server\",application=~\"$application\",domain=~\"$domain\",application!=\"\",domain!=\"\"}[5m]))",
          "legendFormat": "{{domain}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "links": [
            {
              "title": "This domain",
              "url": "/d/server-tools-http?${__url_time_range}&var-server=${__field.labels.server}&var-application=${__field.labels.application}&var-domain=${__field.labels.domain}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      }
    }
  ]
}
