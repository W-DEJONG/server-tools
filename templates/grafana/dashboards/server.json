{
  "uid": "server-tools-server",
  "title": "Server overview",
  "description": "CPU, memory, disk, load and network for servers scraped by Alloy.",
  "tags": ["server-tools"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "server",
        "label": "Server",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(node_uname_info, server)",
        "definition": "label_values(node_uname_info, server)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "100 - (avg by (server) (rate(node_cpu_seconds_total{server=~\"$server\",mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "{{server}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100 },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memory",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "(1 - (node_memory_MemAvailable_bytes{server=~\"$server\"} / node_memory_MemTotal_bytes{server=~\"$server\"})) * 100",
          "legendFormat": "{{server}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100 },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Load",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "node_load1{server=~\"$server\"}",
          "legendFormat": "{{server}} 1m"
        },
        {
          "refId": "B",
          "expr": "node_load5{server=~\"$server\"}",
          "legendFormat": "{{server}} 5m"
        },
        {
          "refId": "C",
          "expr": "node_load15{server=~\"$server\"}",
          "legendFormat": "{{server}} 15m"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Disk",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "100 - (node_filesystem_avail_bytes{server=~\"$server\",fstype!~\"tmpfs|overlay|squashfs|ramfs|devtmpfs\"} / node_filesystem_size_bytes{server=~\"$server\",fstype!~\"tmpfs|overlay|squashfs|ramfs|devtmpfs\"}) * 100",
          "legendFormat": "{{server}} {{mountpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100 },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Network",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (server) (rate(node_network_receive_bytes_total{server=~\"$server\",device!~\"lo\"}[5m]))",
          "legendFormat": "{{server}} in"
        },
        {
          "refId": "B",
          "expr": "sum by (server) (rate(node_network_transmit_bytes_total{server=~\"$server\",device!~\"lo\"}[5m]))",
          "legendFormat": "{{server}} out"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] }
    }
  ]
}
