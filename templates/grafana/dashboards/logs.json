{
  "uid": "server-tools-logs",
  "title": "Application logs",
  "description": "Nginx, worker and Laravel logs collected by Alloy. Laravel logs stay on current/storage/logs across deploys.",
  "tags": ["server-tools"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "server",
        "label": "Server",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values(server)",
        "definition": "label_values(server)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "sort": 1
      },
      {
        "name": "username",
        "label": "User",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values(username)",
        "definition": "label_values(username)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "sort": 1
      },
      {
        "name": "application",
        "label": "Application",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values(application)",
        "definition": "label_values(application)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "sort": 1
      },
      {
        "name": "logtype",
        "label": "Log type",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values(logtype)",
        "definition": "label_values(logtype)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "logs",
      "title": "Logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 18, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "{server=~\"$server\", username=~\"$username\", application=~\"$application\", logtype=~\"$logtype\"}"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    }
  ]
}
